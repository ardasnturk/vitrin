# Generated by Vitrin. `vitrin upload` calls this lane for Google Play; it can also be run by hand.
# vitrin-template: 3
# Values are read from .env and never logged.
#
# Google Play (supply), listing text, release notes and images only (never a binary, a track change or a rollout):
#   bundle exec fastlane android vitrin_play_upload [validate_only:true]
#
# supply replaces only the image types that have files, and the release notes of the version code for all languages.
# App Store uploads do not use fastlane: Vitrin drives the asc CLI (brew install asc).
require "base64"

default_platform(:android)

platform :android do
  # Service account key: GOOGLE_PLAY_JSON_KEY_BASE64 (CI) or a file path. supply masks json_key_data in its summary.
  def vitrin_play_key
    b64 = ENV["GOOGLE_PLAY_JSON_KEY_BASE64"].to_s.strip
    return { json_key_data: Base64.decode64(b64) } unless b64.empty?
    path = ENV["VITRIN_PLAY_JSON_KEY_PATH"].to_s.strip
    path = ENV.fetch("GOOGLE_PLAY_JSON_KEY_PATH") if path.empty?
    { json_key: path }
  end

  desc "Uploads the Google Play listing (text, release notes, screenshots, feature graphic, icon). Never uploads a binary, changes a track or rolls out."
  lane :vitrin_play_upload do |options|
    version_code = ENV["VITRIN_PLAY_VERSION_CODE"].to_s.strip
    validate_only = options[:validate_only].to_s == "true" || ENV["VITRIN_PLAY_VALIDATE_ONLY"] == "1"
    upload_to_play_store(vitrin_play_key.merge(
      package_name: ENV.fetch("VITRIN_PLAY_PACKAGE_NAME"),
      metadata_path: ENV.fetch("VITRIN_PLAY_METADATA_PATH", "fastlane/metadata/android"),
      # supply reads the release on this track to attach release notes; the track itself is not modified.
      track: ENV.fetch("VITRIN_PLAY_TRACK", "production"),
      version_code: version_code.empty? ? nil : version_code.to_i,
      skip_upload_apk: true,
      skip_upload_aab: true,
      # supply replaces the release notes of the version code for every language at once.
      skip_upload_changelogs: version_code.empty? || ENV["VITRIN_PLAY_SKIP_CHANGELOGS"] == "1",
      skip_upload_metadata: ENV["VITRIN_PLAY_SKIP_METADATA"] == "1",
      skip_upload_images: ENV["VITRIN_PLAY_SKIP_IMAGES"] == "1",
      skip_upload_screenshots: ENV["VITRIN_PLAY_SKIP_SCREENSHOTS"] == "1",
      sync_image_upload: true,
      validate_only: validate_only
    ).compact)
  end
end
