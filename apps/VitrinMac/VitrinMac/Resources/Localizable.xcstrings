    "info.asc.store.eula" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The terms people accept. Without your own, Apple's standard agreement applies."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanıcıların kabul ettiği koşullar. Kendi sözleşmeniz yoksa Apple'ın standart sözleşmesi geçerlidir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bedingungen, denen Nutzer zustimmen. Ohne eigene gilt Apples Standardvereinbarung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los términos que acepta la gente. Si no pones los tuyos, se aplica el acuerdo estándar de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les conditions que les gens acceptent. Sans les vôtres, l’accord standard d’Apple s’applique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I termini che le persone accettano. Senza i tuoi, vale il contratto standard di Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザが同意する規約です。独自の規約がない場合は、Apple の標準契約が適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자가 동의하는 약관입니다. 별도로 지정하지 않으면 Apple의 표준 계약이 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
