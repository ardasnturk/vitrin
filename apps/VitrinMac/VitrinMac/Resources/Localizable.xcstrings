    "ads.step3" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After Save, Apple shows clientId, teamId and keyId on the same page. Paste the whole block into any field and all three fill in."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save'den sonra Apple aynı sayfada clientId, teamId ve keyId gösterir. Bloğun tamamını herhangi bir alana yapıştırın, üçü de dolar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach Save zeigt Apple clientId, teamId und keyId auf derselben Seite. Fügen Sie den ganzen Block in ein beliebiges Feld ein, dann füllen sich alle drei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras Save, Apple muestra clientId, teamId y keyId en la misma página. Pega el bloque entero en cualquier campo y los tres se rellenan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après Save, Apple affiche clientId, teamId et keyId sur la même page. Collez tout le bloc dans n’importe quel champ et les trois se remplissent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo Save, Apple mostra clientId, teamId e keyId nella stessa pagina. Incolla l’intero blocco in un campo qualsiasi e tutti e tre si compilano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save をクリックすると、同じページに clientId、teamId、keyId が表示されます。ブロックごとどれかの欄に貼り付けると、3つとも自動で入力されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save를 클릭하면 Apple이 같은 페이지에 clientId, teamId, keyId를 표시합니다. 전체 블록을 아무 필드에나 붙여넣으면 세 항목이 모두 채워집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de Save, a Apple mostra clientId, teamId e keyId na mesma página. Cole o bloco inteiro em qualquer campo e os três serão preenchidos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按 Save 后，Apple 会在同一页面显示 clientId、teamId 和 keyId。将整段内容粘贴到任意一个字段，三项就会自动填好。"
          }
        }
      }
    },
