    "info.act.price" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app's own price. Base territory is the country Apple converts the other prices from."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamanın kendi fiyatı. Temel bölge, diğer fiyatların dönüştürüldüğü ülkedir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Preis der App selbst. Die Basisregion ist das Land, von dem aus Apple die übrigen Preise umrechnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El precio propio de la app. El territorio base es el país a partir del cual Apple convierte los demás precios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le prix de l’app elle-même. Le territoire de base est le pays à partir duquel Apple convertit les autres prix."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il prezzo dell’app. Il territorio di base è il paese da cui Apple converte gli altri prezzi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appの価格です。基準の国または地域は、Apple がほかの価格を換算する際の基準になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 자체의 가격입니다. 기준 국가 또는 지역은 Apple이 다른 가격을 환산할 때 기준으로 삼는 곳입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O preço do próprio app. O território base é o país a partir do qual a Apple converte os outros preços."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 自身的价格。基准国家或地区是 Apple 换算其他价格时所依据的国家或地区。"
          }
        }
      }
    },
