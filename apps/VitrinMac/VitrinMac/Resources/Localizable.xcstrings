    "onb.account.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect App Store Connect"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store Connect’i bağlayın"
          }
        }
      }
    },
    "onb.account.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One API key for every app and project. Vitrin checks it by listing your team’s apps."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm uygulamalar ve projeler için tek API anahtarı. Vitrin anahtarı takımınızın uygulamalarını listeleyerek doğrular."
          }
        }
      }
    },
    "onb.account.how": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a key"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar oluşturun"
          }
        }
      }
    },
    "onb.account.step1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the API keys page"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API anahtarları sayfasını açın"
          }
        }
      }
    },
    "onb.account.step1.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store Connect → Users and Access → Integrations → App Store Connect API → Team Keys."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store Connect → Kullanıcılar ve Erişim → Entegrasyonlar → App Store Connect API → Takım Anahtarları."
          }
        }
      }
    },
    "onb.account.step2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generate a key with the App Manager role"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Manager rolüyle bir anahtar üretin"
          }
        }
      }
    },
    "onb.account.step2.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note the Key ID next to it and the Issuer ID above the list."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanındaki Key ID’yi ve listenin üstündeki Issuer ID’yi not edin."
          }
        }
      }
    },
    "onb.account.step3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download the .p8 file"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ".p8 dosyasını indirin"
          }
        }
      }
    },
    "onb.account.step3.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple lets you download it only once. Choose it below; Vitrin keeps its own copy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple yalnızca bir kez indirmenize izin verir. Aşağıda seçin; Vitrin kendi kopyasını saklar."
          }
        }
      }
    },
    "onb.account.form": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your key"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarınız"
          }
        }
      }
    },
    "onb.account.saveCheck": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save and check"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydet ve doğrula"
          }
        }
      }
    },
    "onb.account.saved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key saved"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar kaydedildi"
          }
        }
      }
    },
    "onb.account.change": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değiştir…"
          }
        }
      }
    },
    "onb.account.checking": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading your team’s apps…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takımınızın uygulamaları okunuyor…"
          }
        }
      }
    },
    "onb.account.ok": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key works: {n} apps found."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar çalışıyor: {n} uygulama bulundu."
          }
        }
      }
    },
    "onb.account.privacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The .p8 is copied to ~/Library/Application Support/Vitrin with owner-only permissions. It never leaves this Mac except to sign requests to Apple."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ".p8 yalnızca sahibinin okuyabileceği izinlerle ~/Library/Application Support/Vitrin altına kopyalanır. Apple’a giden isteklerin imzası dışında bu Mac’ten çıkmaz."
          }
        }
      }
    },
    "onb.apps.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps and projects"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar ve projeler"
          }
        }
      }
    },
    "onb.apps.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your team’s apps come from App Store Connect. Link an app to its source folder to let Vitrin write its listing."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takımınızın uygulamaları App Store Connect’ten gelir. Listesini Vitrin’in yazması için bir uygulamayı kaynak klasörüne bağlayın."
          }
        }
      }
    },
    "onb.apps.noKey": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a key in the previous step to see your team’s apps here. You can still add project folders."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takımınızın uygulamalarını burada görmek için önceki adımda anahtar ekleyin. Proje klasörü yine de ekleyebilirsiniz."
          }
        }
      }
    },
    "onb.apps.projects": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A project is an app’s source folder (the Xcode, Flutter or React Native repository). Vitrin writes everything into its metadata/ folder."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proje, bir uygulamanın kaynak klasörüdür (Xcode, Flutter ya da React Native deposu). Vitrin her şeyi onun metadata/ klasörüne yazar."
          }
        }
      }
    },
    "onb.claude.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude"
          }
        }
      }
    },
    "onb.claude.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code writes the creative stages in your project. Choose the model it uses; you can change it any time."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code projenizde yaratıcı aşamaları yazar. Kullanacağı modeli seçin; istediğiniz zaman değiştirebilirsiniz."
          }
        }
      }
    },
    "onb.claude.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude runs with your own Claude Code sign-in; Vitrin needs no API key for it. Each run shows the model it used."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude kendi Claude Code oturumunuzla çalışır; Vitrin bunun için API anahtarı istemez. Her çalıştırma kullandığı modeli gösterir."
          }
        }
      }
    },
    "onb.model.default": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code default"
