    "onb.apps.projects" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A project is an app’s source folder (the Xcode, Flutter or React Native repository). Vitrin writes everything into its metadata/ folder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proje, bir uygulamanın kaynak klasörüdür (Xcode, Flutter ya da React Native deposu). Vitrin her şeyi onun metadata/ klasörüne yazar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Projekt ist der Quellordner einer App (das Xcode-, Flutter- oder React-Native-Repository). Vitrin schreibt alles in dessen Ordner metadata/."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un proyecto es la carpeta de código de una app (el repositorio de Xcode, Flutter o React Native). Vitrin lo escribe todo en su carpeta metadata/."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un projet est le dossier source d’une app (le dépôt Xcode, Flutter ou React Native). Vitrin écrit tout dans son dossier metadata/."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un progetto è la cartella sorgente di un’app (il repository Xcode, Flutter o React Native). Vitrin scrive tutto nella sua cartella metadata/."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトとは、Appのソースフォルダ (Xcode、Flutter、React Native のリポジトリ) のことです。Vitrin はすべてその中の metadata/ フォルダに書き込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로젝트는 앱의 소스 폴더(Xcode, Flutter 또는 React Native 저장소)입니다. Vitrin은 모든 내용을 해당 폴더의 metadata/ 폴더에 작성합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um projeto é a pasta de código-fonte de um app (o repositório do Xcode, Flutter ou React Native). O Vitrin grava tudo na pasta metadata/ dele."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项目就是 App 的源代码文件夹（Xcode、Flutter 或 React Native 仓库）。Vitrin 会把所有内容写入其中的 metadata/ 文件夹。"
          }
        }
      }
    },
    "onb.apps.subtitle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your team’s apps come from App Store Connect. Link an app to its source folder to let Vitrin write its listing."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takımınızın uygulamaları App Store Connect’ten gelir. Listesini Vitrin’in yazması için bir uygulamayı kaynak klasörüne bağlayın."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Apps Ihres Teams stammen aus App Store Connect. Verknüpfen Sie eine App mit ihrem Quellordner, damit Vitrin ihren Eintrag schreiben kann."
