    "web.why" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple only allows this through your Apple Account, not an API key. Vitrin doesn't keep your password: asc stores it in your Mac's keychain after you sign in."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple buna API anahtarıyla değil, yalnızca Apple Hesabınızla izin veriyor. Vitrin şifrenizi saklamaz: giriş yaptıktan sonra asc onu Mac'inizin anahtar zincirine kaydeder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple erlaubt dies nur über Ihren Apple-Account, nicht über einen API-Schlüssel. Vitrin speichert Ihr Passwort nicht: asc legt es nach der Anmeldung im Schlüsselbund Ihres Mac ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple solo permite esto a través de tu cuenta de Apple, no con una clave de API. Vitrin no guarda tu contraseña: asc la almacena en el llavero de tu Mac después de iniciar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple n’autorise cette opération que via votre compte Apple, et non avec une clé d’API. Vitrin ne conserve pas votre mot de passe : asc l’enregistre dans le trousseau de votre Mac après la connexion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple lo consente solo tramite il tuo account Apple, non con una chiave API. Vitrin non conserva la tua password: asc la salva nel portachiavi del tuo Mac dopo l’accesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この操作はAPIキーではなく、Apple アカウントでのみ実行できます。Vitrinはパスワードを保存しません。サインイン後、ascがMacのキーチェーンに保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple은 API 키가 아닌 Apple 계정으로만 이 작업을 허용합니다. Vitrin은 암호를 보관하지 않으며, 로그인 후 asc가 Mac의 키체인에 저장합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Apple só permite isso por meio da sua conta Apple, não com uma chave de API. O Vitrin não guarda sua senha: o asc a armazena nas Chaves do seu Mac depois que você entra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 只允许通过你的 Apple 账户执行此操作，而不能使用 API 密钥。Vitrin 不会保存你的密码：登录后，asc 会将其存储在你 Mac 的钥匙串中。"
          }
        }
      }
    },
    "welcome.intro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a mobile app’s repository and Vitrin builds its store listing step by step: research, text, screenshots, App Previews, review, upload. Everything lands in the project’s metadata/ folder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir mobil uygulamanın deposunu ekleyin; Vitrin mağaza listesini adım adım kurar: araştırma, metin, ekran görüntüleri, App Preview, inceleme, yükleme. Her şey projenin metadata/ klasörüne yazılır."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie das Repository einer mobilen App hinzu, und Vitrin erstellt den Store-Eintrag Schritt für Schritt: Recherche, Text, Screenshots, App-Vorschauen, Prüfung, Upload. Alles landet im Ordner metadata/ des Projekts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade el repositorio de una app móvil y Vitrin crea su ficha de la tienda paso a paso: investigación, texto, capturas, App Previews, revisión, subida. Todo queda en la carpeta metadata/ del proyecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez le dépôt d’une app mobile et Vitrin construit sa fiche étape par étape : recherche, texte, captures d’écran, aperçus d’app, revue, envoi. Tout est enregistré dans le dossier metadata/ du projet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi il repository di un’app mobile e Vitrin costruisce la sua scheda dello store passo dopo passo: ricerca, testi, screenshot, anteprime app, revisione, caricamento. Tutto finisce nella cartella metadata/ del progetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モバイルAppのリポジトリを追加すると、Vitrin が調査、テキスト作成、スクリーンショット、Appプレビュー、確認、アップロードの順にストア掲載を作り上げます。成果物はすべてプロジェクトの metadata/ フォルダに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모바일 앱의 저장소를 추가하면 Vitrin이 조사, 텍스트, 스크린샷, 앱 미리보기, 검토, 업로드 순서로 스토어 상품 정보를 단계별로 만듭니다. 모든 결과는 프로젝트의 metadata/ 폴더에 저장됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione o repositório de um app e o Vitrin monta a página dele na loja passo a passo: pesquisa, texto, capturas de tela, App Previews, revisão e envio. Tudo fica na pasta metadata/ do projeto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加移动 App 的仓库，Vitrin 会逐步完成其商店商品信息：调研、文案、截图、App 预览、审核、上传。所有内容都会存入项目的 metadata/ 文件夹。"
          }
        }
      }
    },
