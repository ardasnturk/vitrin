    "asc.shelf.intro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything else App Store Connect can do here. What only reads opens in place; a button changes something and always shows a short form first."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect'te burada yapılabilecek diğer her şey. Sadece okuyanlar yerinde açılır; butonlar bir şeyi değiştirir ve önce kısa bir form gösterir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles andere, was App Store Connect hier kann. Was nur liest, öffnet sich direkt; eine Taste ändert etwas und zeigt immer zuerst ein kurzes Formular."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo demás que App Store Connect puede hacer aquí. Lo que solo lee se abre en el sitio; un botón cambia algo y siempre muestra antes un breve formulario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce qu’App Store Connect peut faire d’autre ici. Ce qui se contente de lire s’ouvre directement ; un bouton qui modifie quelque chose affiche toujours d’abord un court formulaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto il resto che App Store Connect può fare qui. Ciò che si limita a leggere si apre sul posto; un pulsante modifica qualcosa e mostra sempre prima un breve modulo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect のその他の操作をここから行えます。読み取りのみの項目はその場で開き、ボタンは内容を変更するため、先に短いフォームが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 밖에 App Store Connect에서 할 수 있는 모든 작업입니다. 읽기만 하는 항목은 바로 열리고, 버튼으로 무언가를 변경할 때는 항상 먼저 간단한 양식이 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo o mais que o App Store Connect pode fazer aqui. O que só lê abre no mesmo lugar; um botão altera algo e sempre mostra antes um formulário curto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect 在此能做的其他所有事。只读内容会就地打开；按钮会更改数据，并且总是先显示一个简短的表单。"
          }
        }
      }
    },
