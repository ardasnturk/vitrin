    "apps.linkHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Link the folder of this app’s repository to write its store text and render its screenshots and videos with Vitrin. Vitrin recognises the folder by the bundle id in vitrin.config.yaml."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mağaza metnini yazmak, ekran görüntülerini ve videolarını Vitrin ile üretmek için bu uygulamanın depo klasörünü bağlayın. Vitrin klasörü vitrin.config.yaml’daki bundle id ile tanır."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verknüpfen Sie den Repository-Ordner dieser App, um mit Vitrin ihren Store-Text zu schreiben sowie Screenshots und Videos zu erstellen. Vitrin erkennt den Ordner an der Bundle-ID in vitrin.config.yaml."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vincula la carpeta del repositorio de esta app para que Vitrin escriba su texto de la tienda y genere sus capturas y vídeos. Vitrin reconoce la carpeta por el bundle ID de vitrin.config.yaml."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Associez le dossier du dépôt de cette app pour rédiger son texte, et générer ses captures d’écran et ses vidéos avec Vitrin. Vitrin reconnaît le dossier grâce au bundle ID dans vitrin.config.yaml."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega la cartella del repository di questa app per scrivere i testi dello store e generare screenshot e video con Vitrin. Vitrin riconosce la cartella dal bundle ID in vitrin.config.yaml."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このAppのリポジトリのフォルダをリンクすると、Vitrin でストア用テキストの作成と、スクリーンショットやビデオの生成ができます。Vitrin は vitrin.config.yaml のバンドル ID でフォルダを識別します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱의 저장소 폴더를 연결하면 Vitrin으로 스토어 텍스트를 작성하고 스크린샷과 비디오를 렌더링할 수 있습니다. Vitrin은 vitrin.config.yaml의 번들 ID로 폴더를 인식합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vincule a pasta do repositório deste app para escrever o texto da loja e gerar as capturas de tela e os vídeos com o Vitrin. O Vitrin reconhece a pasta pelo bundle ID no vitrin.config.yaml."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关联此 App 的仓库文件夹，即可用 Vitrin 撰写商店文案并渲染截图和视频。Vitrin 通过 vitrin.config.yaml 中的 bundle id 识别该文件夹。"
          }
        }
      }
    },
