    "settings.cliHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search order: the path above, the Claude Code plugin install (~/.local/share/vitrin), vitrin on PATH, then packages/cli/dist/bin.js in the checkout. Node.js 22+ is required."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arama sırası: yukarıdaki yol, Claude Code eklenti kurulumu (~/.local/share/vitrin), PATH üzerindeki vitrin, sonra kopyadaki packages/cli/dist/bin.js. Node.js 22+ gerekir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suchreihenfolge: der Pfad oben, die Claude-Code-Plug-in-Installation (~/.local/share/vitrin), vitrin im PATH, dann packages/cli/dist/bin.js im Checkout. Node.js 22+ ist erforderlich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orden de búsqueda: la ruta de arriba, la instalación del plugin de Claude Code (~/.local/share/vitrin), vitrin en el PATH y, por último, packages/cli/dist/bin.js en el repositorio. Se requiere Node.js 22 o posterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordre de recherche : le chemin ci-dessus, l’installation du plug-in Claude Code (~/.local/share/vitrin), vitrin dans le PATH, puis packages/cli/dist/bin.js dans le dépôt cloné. Node.js 22 ou ultérieur est requis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordine di ricerca: il percorso sopra, l’installazione del plugin Claude Code (~/.local/share/vitrin), vitrin nel PATH, poi packages/cli/dist/bin.js nel checkout. Serve Node.js 22 o successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "探索の順序は、上のパス、Claude Code プラグインのインストール先 (~/.local/share/vitrin)、PATH 上の vitrin、チェックアウト内の packages/cli/dist/bin.js です。Node.js 22 以降が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색 순서: 위의 경로, Claude Code 플러그인 설치 위치(~/.local/share/vitrin), PATH의 vitrin, 체크아웃의 packages/cli/dist/bin.js 순입니다. Node.js 22 이상이 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordem de busca: o caminho acima, a instalação do plugin do Claude Code (~/.local/share/vitrin), o vitrin no PATH e, por fim, packages/cli/dist/bin.js no checkout. É necessário o Node.js 22 ou mais recente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
