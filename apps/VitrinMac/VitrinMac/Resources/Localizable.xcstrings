    "info.asc.meta.version" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text belongs to a version. Once a version is live it's locked, except the promotional text."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metinler sürüme bağlıdır. Yayındaki sürüm kilitlidir; yalnızca tanıtım metni değişebilir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texte gehören zu einer Version. Sobald eine Version live ist, ist sie gesperrt, außer dem Werbetext."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El texto pertenece a una versión. Cuando la versión está publicada, queda bloqueado, salvo el texto promocional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le texte est lié à une version. Une fois la version en ligne, il est verrouillé, sauf le texte promotionnel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il testo appartiene a una versione. Quando la versione è online, è bloccato, tranne il testo promozionale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキストはバージョンごとに管理されます。バージョンが公開されると、プロモーション用テキスト以外は編集できなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트는 버전에 속합니다. 버전이 게시되면 프로모션 텍스트를 제외하고 잠깁니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O texto pertence a uma versão. Depois que a versão está no ar, ele fica bloqueado, exceto o texto promocional."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文案属于某个版本。版本上线后即被锁定，宣传文本除外。"
          }
        }
      }
    },
    "info.asc.ready.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checks the version before App Review. Blocking items stop the submission; warnings don't, but they're worth a look."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sürümü App Review öncesi denetler. Engeller gönderimi durdurur; uyarılar durdurmaz ama bakmaya değer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüft die Version vor der App-Prüfung. Blockierende Punkte stoppen die Einreichung; Warnungen nicht, aber ein Blick lohnt sich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba la versión antes de App Review. Los elementos bloqueantes detienen el envío; los avisos no, pero conviene echarles un vistazo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie la version avant l’App Review. Les éléments bloquants empêchent la soumission ; les avertissements non, mais ils méritent un coup d’œil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla la versione prima di App Review. Gli elementi bloccanti fermano l’invio; gli avvisi no, ma vale la pena dargli un’occhiata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App審査の前にバージョンを確認します。ブロック項目があると提出できません。警告は提出を止めませんが、確認をおすすめします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Review 전에 버전을 점검합니다. 차단 항목은 제출을 막고, 경고는 막지 않지만 확인해 볼 만합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica a versão antes da Análise do App. Itens bloqueantes impedem o envio; avisos não impedem, mas vale a pena olhar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 App 审核之前检查版本。阻止性项目会中止提交；警告不会，但值得留意。"
          }
        }
      }
    },
    "info.asc.reviewInfo.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What Apple's reviewers see with this version: who to contact, a demo account if the app needs one, and your notes. It isn't shown on the store."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple'ın inceleme ekibinin bu sürümle gördükleri: iletişim kişisi, gerekiyorsa demo hesap ve notlarınız. Mağazada görünmez."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was Apples Prüfer bei dieser Version sehen: Ansprechperson, ein Demokonto, falls die App eines braucht, und Ihre Hinweise. Im Store wird es nicht angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que ven los revisores de Apple con esta versión: a quién contactar, una cuenta de demostración si la app la necesita y tus notas. No se muestra en la tienda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que voient les évaluateurs d’Apple avec cette version : qui contacter, un compte de démonstration si l’app en a besoin, et vos notes. Rien de tout cela n’est affiché sur le store."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa vedono i revisori di Apple con questa versione: chi contattare, un account demo se serve all’app e le tue note. Non viene mostrato sullo store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバージョンでApple の審査担当者が確認する内容です。連絡先、Appに必要な場合はデモアカウント、メモが含まれます。ストアには表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 버전에 대해 Apple 심사 담당자가 보는 내용입니다: 연락처, 앱에 필요한 경우 데모 계정, 사용자의 노트. 스토어에는 표시되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que os revisores da Apple veem com esta versão: quem contatar, uma conta de demonstração se o app precisar e as suas notas. Não aparece na loja."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 审核人员对此版本所看到的内容：联系人、App 需要时的演示账户，以及你的备注。这些内容不会显示在商店中。"
          }
        }
      }
    },
