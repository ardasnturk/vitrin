    "review.needsValid" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approval needs a clean validation first; run “Check everything”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onay için önce temiz bir doğrulama gerekir; “Her şeyi kontrol et” aşamasını çalıştırın."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Freigabe setzt zuerst eine saubere Validierung voraus; führen Sie „Alles prüfen“ aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aprobación requiere antes una validación sin errores; ejecuta «Comprobar todo»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’approbation exige d’abord une validation sans erreur ; lancez « Tout vérifier »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per approvare serve prima una convalida senza problemi; esegui “Controlla tutto”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "承認するには、先に検証でエラーがない状態にする必要があります。「すべて確認」を実行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "승인하려면 먼저 검증을 문제없이 통과해야 합니다. “전체 점검”을 실행하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A aprovação exige antes uma validação sem problemas; execute “Verificar tudo”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "批准前需先通过验证；请运行“全面检查”。"
          }
        }
      }
    },
    "review.noReport" : {
      "localizations" : {
        "en" : {
