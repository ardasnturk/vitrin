    "ads.step2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin made a key pair; the private key stays on this Mac. Signed in as the API user, go to Account Settings > API, paste the key below into Public Key, and click Save."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin bir anahtar çifti oluşturdu; gizli anahtar bu Mac'te kalır. API kullanıcısıyla girip Account Settings > API'de aşağıdaki anahtarı Public Key alanına yapıştırın ve Save'e tıklayın."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin hat ein Schlüsselpaar erstellt; der private Schlüssel bleibt auf diesem Mac. Melden Sie sich als API-Benutzer an, öffnen Sie Account Settings > API, fügen Sie den Schlüssel unten in Public Key ein und klicken Sie auf Save."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin ha creado un par de claves; la clave privada se queda en este Mac. Con la sesión iniciada como usuario de API, ve a Account Settings > API, pega la clave de abajo en Public Key y haz clic en Save."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin a créé une paire de clés ; la clé privée reste sur ce Mac. Connecté en tant qu’utilisateur d’API, allez dans Account Settings > API, collez la clé ci-dessous dans Public Key, puis cliquez sur Save."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin ha creato una coppia di chiavi; la chiave privata resta su questo Mac. Dopo aver effettuato l’accesso come utente API, vai a Account Settings > API, incolla la chiave qui sotto in Public Key e fai clic su Save."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin がキーペアを作成しました。秘密鍵はこの Mac から出ません。API ユーザとしてサインインし、Account Settings > API を開いて、下のキーを Public Key に貼り付け、Save をクリックします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin이 키 쌍을 만들었으며 개인 키는 이 Mac에 남아 있습니다. API 사용자로 로그인한 상태에서 Account Settings > API로 이동해 아래 키를 Public Key에 붙여넣고 Save를 클릭하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Vitrin criou um par de chaves; a chave privada fica neste Mac. Com o login do usuário de API, vá em Account Settings > API, cole a chave abaixo em Public Key e clique em Save."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin 已生成一对密钥；私钥只保存在这台 Mac 上。以 API 用户身份登录后，前往 Account Settings > API，将下方的密钥粘贴到 Public Key，然后点按 Save。"
          }
        }
      }
    },
