        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nome sull’App Store, fino a 30 caratteri. Deve essere libero in tutto lo store; potrai cambiarlo in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Storeに表示される名前で、30文字以内です。ストア全体で未使用である必要があります。後から変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store에 표시되는 이름으로, 최대 30자입니다. 스토어 전체에서 고유해야 하며 나중에 변경할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O nome na App Store, com até 30 caracteres. Ele precisa estar livre em toda a loja; você pode alterá-lo depois."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store 上显示的名称，最多 30 个字符。它在整个商店中必须唯一；之后可以更改。"
          }
        }
      }
    },
    "info.newapp.sku" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your own reference for the app, not shown on the store. Any unique value works; Vitrin suggests the bundle ID."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
