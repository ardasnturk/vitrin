    "asc.connect.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin manages your apps through the asc CLI. Add your API key once in Settings, or sign in with `asc auth login` in Terminal: Vitrin uses whichever it finds. Local projects work without a connection."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin uygulamalarınızı asc CLI ile yönetir. API anahtarınızı Ayarlar’dan bir kez ekleyin ya da Terminal’de `asc auth login` ile oturum açın: Vitrin hangisini bulursa onu kullanır. Yerel projeler bağlantı olmadan da çalışır."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin verwaltet Ihre Apps über die asc CLI. Fügen Sie Ihren API-Schlüssel einmal in den Einstellungen hinzu oder melden Sie sich im Terminal mit `asc auth login` an: Vitrin nutzt, was es findet. Lokale Projekte funktionieren ohne Verbindung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin gestiona tus apps mediante la CLI de asc. Añade tu clave de API una vez en Ajustes, o inicia sesión con `asc auth login` en Terminal: Vitrin usa la que encuentre. Los proyectos locales funcionan sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin gère vos apps via la CLI asc. Ajoutez votre clé d’API une fois dans les Réglages, ou connectez-vous avec `asc auth login` dans le Terminal : Vitrin utilise celle qu’il trouve. Les projets locaux fonctionnent sans connexion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin gestisce le tue app tramite la CLI asc. Aggiungi la chiave API una volta in Impostazioni, oppure accedi con `asc auth login` nel Terminale: Vitrin usa quella che trova. I progetti locali funzionano anche senza connessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin は asc CLI を通じてAppを管理します。設定で API キーを一度追加するか、ターミナルで `asc auth login` を実行してサインインしてください。どちらか見つかったほうを使います。ローカルのプロジェクトは接続なしでも使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin은 asc CLI로 앱을 관리합니다. 설정에서 API 키를 한 번 추가하거나 터미널에서 `asc auth login`으로 로그인하세요. Vitrin은 찾은 쪽을 사용합니다. 로컬 프로젝트는 연결 없이도 작동합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Vitrin gerencia seus apps por meio da CLI do asc. Adicione sua chave de API uma vez em Ajustes ou faça login com `asc auth login` no Terminal: o Vitrin usa a que encontrar. Projetos locais funcionam sem conexão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin 通过 asc CLI 管理你的 App。请在设置中添加一次 API 密钥，或在“终端”中用 `asc auth login` 登录：Vitrin 会使用它找到的任意一种。本地项目无需连接即可使用。"
          }
        }
      }
    },
