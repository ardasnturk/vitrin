    "info.asc.analytics.performance" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Launch time, hangs and disk writes from real devices, the same data as Xcode Organizer. It needs enough users to appear."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerçek cihazlardan açılış süresi, takılmalar ve disk yazmaları; Xcode Organizer'daki veriler. Görünmesi için yeterli kullanıcı gerekir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startzeit, Hänger und Schreibzugriffe von echten Geräten, dieselben Daten wie im Xcode Organizer. Es sind genügend Nutzer nötig, damit sie erscheinen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiempo de arranque, bloqueos y escrituras en disco de dispositivos reales, los mismos datos que Xcode Organizer. Necesita suficientes usuarios para aparecer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temps de lancement, blocages et écritures disque sur de vrais appareils, les mêmes données que dans Xcode Organizer. Il faut assez d’utilisateurs pour qu’elles apparaissent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo di avvio, blocchi e scritture su disco da dispositivi reali, gli stessi dati di Xcode Organizer. Servono abbastanza utenti perché compaiano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実機での起動時間、ハング、ディスク書き込みで、Xcode Organizer と同じデータです。表示にはある程度のユーザ数が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실제 기기의 실행 시간, 멈춤, 디스크 쓰기 데이터로, Xcode Organizer와 같은 데이터입니다. 표시되려면 사용자가 충분히 있어야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo de abertura, travamentos e gravações em disco de dispositivos reais, os mesmos dados do Xcode Organizer. É preciso ter usuários suficientes para aparecer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自真实设备的启动时间、卡顿和磁盘写入数据，与 Xcode Organizer 中的相同。需要足够多的用户才会显示。"
          }
        }
      }
    },
    "info.asc.analytics.requests" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple's analytics reports: downloads, sessions, sales and more. Once requested, they update by themselves."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple'ın analitik raporları: indirmeler, oturumlar, satışlar ve dahası. Bir kez istenince kendiliğinden güncellenir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apples Analyseberichte: Downloads, Sitzungen, Verkäufe und mehr. Einmal angefordert, aktualisieren sie sich selbst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informes de analíticas de Apple: descargas, sesiones, ventas y más. Una vez solicitados, se actualizan solos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rapports d’analyse d’Apple : téléchargements, sessions, ventes et plus. Une fois demandés, ils se mettent à jour automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I report di analisi di Apple: download, sessioni, vendite e altro. Una volta richiesti, si aggiornano da soli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple の分析レポートで、ダウンロード、セッション、売上などを確認できます。一度リクエストすると、自動で更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple의 분석 리포트: 다운로드, 세션, 판매 등입니다. 한 번 요청하면 자동으로 업데이트됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relatórios de análises da Apple: downloads, sessões, vendas e mais. Depois de solicitados, eles se atualizam sozinhos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 的分析报告：下载量、会话、销售等。请求一次后会自动更新。"
          }
        }
      }
    },
