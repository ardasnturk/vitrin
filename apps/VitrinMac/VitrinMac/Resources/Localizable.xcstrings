    "asc.analytics.intro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sales, downloads, usage and performance reports from App Store Connect. Sales reports need your vendor number (App Store Connect → Payments and Financial Reports)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect’ten satış, indirme, kullanım ve performans raporları. Satış raporları satıcı numaranızı ister (App Store Connect → Ödemeler ve Finansal Raporlar)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berichte zu Verkäufen, Downloads, Nutzung und Leistung aus App Store Connect. Verkaufsberichte benötigen Ihre Anbieternummer (App Store Connect → Zahlungen und Finanzberichte)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informes de ventas, descargas, uso y rendimiento de App Store Connect. Los informes de ventas necesitan tu número de proveedor (App Store Connect → Payments and Financial Reports)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapports de ventes, de téléchargements, d’utilisation et de performance d’App Store Connect. Les rapports de ventes nécessitent votre numéro de fournisseur (App Store Connect → Payments and Financial Reports)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Report di vendite, download, utilizzo e prestazioni da App Store Connect. I report di vendita richiedono il tuo numero fornitore (App Store Connect → Payments and Financial Reports)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect の売上、ダウンロード、使用状況、パフォーマンスのレポートです。売上レポートにはベンダ番号が必要です (App Store Connect → 支払いと財務レポート)。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect의 판매, 다운로드, 사용량, 성능 리포트입니다. 판매 리포트에는 공급업체 번호가 필요합니다(App Store Connect → Payments and Financial Reports)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relatórios de vendas, downloads, uso e desempenho do App Store Connect. Os relatórios de vendas exigem o seu número de fornecedor (App Store Connect → Payments and Financial Reports)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自 App Store Connect 的销售、下载、使用情况和性能报告。销售报告需要你的供应商编号（App Store Connect → Payments and Financial Reports）。"
          }
        }
      }
    },
