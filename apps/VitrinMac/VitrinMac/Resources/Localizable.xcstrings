    "blocker.claude-missing" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code is not installed; the stages that need Claude have to be done by hand. Install: {install}"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code kurulu değil; Claude gerektiren aşamaları elle yapmanız gerekir. Kurulum: {install}"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code ist nicht installiert; die Phasen, die Claude brauchen, müssen von Hand erledigt werden. Installation: {install}"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code no está instalado; las fases que necesitan a Claude hay que hacerlas a mano. Instalación: {install}"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code n’est pas installé ; les étapes qui nécessitent Claude doivent être faites à la main. Installation : {install}"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code non è installato; le fasi che richiedono Claude vanno fatte a mano. Installa con: {install}"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code がインストールされていないため、Claude が必要なステージは手作業で行う必要があります。インストール: {install}"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code가 설치되어 있지 않아 Claude가 필요한 단계는 직접 진행해야 합니다. 설치: {install}"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Claude Code não está instalado; as etapas que precisam do Claude têm de ser feitas manualmente. Instalação: {install}"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未安装 Claude Code；需要 Claude 的阶段只能手动完成。安装方式：{install}"
          }
        }
      }
    },
