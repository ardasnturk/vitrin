    "asc.cmd.allowChangesDetail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off: asc refuses every request that would change App Store Connect (--read-only). On: Vitrin asks before it runs and adds --confirm where asc needs it."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapalı: asc App Store Connect’i değiştirecek her isteği reddeder (--read-only). Açık: Vitrin çalıştırmadan önce sorar ve asc gerektiriyorsa --confirm ekler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus: asc lehnt jede Anfrage ab, die App Store Connect ändern würde (--read-only). Ein: Vitrin fragt vor der Ausführung nach und ergänzt --confirm, wo asc es braucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado: asc rechaza cualquier solicitud que modifique App Store Connect (--read-only). Activado: Vitrin pregunta antes de ejecutar y añade --confirm donde asc lo necesita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé : asc refuse toute requête qui modifierait App Store Connect (--read-only). Activé : Vitrin demande avant d’exécuter et ajoute --confirm là où asc en a besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivato: asc rifiuta ogni richiesta che modificherebbe App Store Connect (--read-only). Attivato: Vitrin chiede prima di eseguire e aggiunge --confirm dove asc lo richiede."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフ: App Store Connect を変更するリクエストは、すべて asc が拒否します (--read-only)。オン: 実行前に Vitrin が確認し、asc が必要とする場合は --confirm を付けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끔: asc가 App Store Connect를 변경하는 모든 요청을 거부합니다(--read-only). 켬: Vitrin이 실행 전에 확인을 요청하고, asc에 필요한 경우 --confirm을 추가합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado: o asc recusa toda solicitação que alteraria o App Store Connect (--read-only). Ativado: o Vitrin pergunta antes de executar e adiciona --confirm onde o asc exige."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭：asc 会拒绝所有会更改 App Store Connect 的请求（--read-only）。开启：Vitrin 会在运行前先询问你，并在 asc 需要时加上 --confirm。"
          }
        }
      }
    },
