    "upload.finalizeIntro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After you checked the store listing: everything stays in metadata/; the research data is deleted only if you say so."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mağaza listesini kontrol ettikten sonra: her şey metadata/ içinde kalır; araştırma verisi yalnızca siz derseniz silinir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachdem Sie den Store-Eintrag geprüft haben: Alles bleibt in metadata/; die Recherchedaten werden nur auf Ihren Wunsch gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de revisar la ficha de la tienda: todo se queda en metadata/; los datos de investigación solo se borran si tú lo indicas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois la fiche vérifiée : tout reste dans metadata/ ; les données de recherche ne sont supprimées que si vous le demandez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo aver controllato la scheda dello store: tutto resta in metadata/; i dati di ricerca vengono eliminati solo se lo chiedi tu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストア掲載を確認したあと、すべて metadata/ に残ります。調査データは、指示した場合にのみ削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스토어 상품 정보를 확인한 후: 모든 내용은 metadata/에 남으며, 조사 데이터는 원할 때만 삭제됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois que você conferir a página da loja: tudo permanece em metadata/; os dados da pesquisa só são apagados se você mandar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确认商店商品信息后：所有内容都保留在 metadata/ 中；只有在你同意时才会删除调研数据。"
          }
        }
      }
    },
    "upload.intro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uploader → keys → approval → dry-run plan → the upload after your confirmation. Nothing is sent before step 5."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yükleyici → anahtarlar → onay → kuru çalıştırma planı → onayınızdan sonra yükleme. 5. adımdan önce hiçbir şey gönderilmez."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uploader → Schlüssel → Freigabe → Testlauf-Plan → Upload nach Ihrer Bestätigung. Vor Schritt 5 wird nichts gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien sube → claves → aprobación → plan de simulación → subida tras tu confirmación. No se envía nada antes del paso 5."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expéditeur → clés → approbation → plan de simulation → envoi après votre confirmation. Rien n’est envoyé avant l’étape 5."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uploader → chiavi → approvazione → piano di simulazione → caricamento dopo la tua conferma. Non viene inviato nulla prima del passaggio 5."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップロード担当 → キー → 承認 → ドライランの計画 → 確認後にアップロード。ステップ5より前には何も送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업로더 → 키 → 승인 → 드라이런 계획 → 확인 후 업로드. 5단계 전에는 아무것도 전송되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envio → chaves → aprovação → plano de simulação → envio após a sua confirmação. Nada é enviado antes da etapa 5."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上传者 → 密钥 → 批准 → 试运行方案 → 你确认后上传。第 5 步之前不会发送任何内容。"
          }
        }
      }
    },
