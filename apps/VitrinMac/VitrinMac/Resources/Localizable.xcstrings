    "info.subscriptions.groups" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A person can have one subscription per group, and can move between plans in it."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kişi grup başına tek abonelik alabilir ve grup içindeki planlar arasında geçebilir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Person kann pro Gruppe ein Abo haben und innerhalb der Gruppe zwischen Tarifen wechseln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una persona puede tener una suscripción por grupo y cambiar de plan dentro de él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une personne peut avoir un abonnement par groupe et peut passer d’une formule à l’autre au sein de ce groupe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una persona può avere un solo abbonamento per gruppo e può passare da un piano all’altro al suo interno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1人につき、グループ内で登録できるサブスクリプションは1つです。グループ内のプラン間では切り替えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 사람은 그룹당 구독 하나만 가질 수 있으며, 그룹 안에서 플랜을 바꿀 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
