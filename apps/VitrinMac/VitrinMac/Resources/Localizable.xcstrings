    "init.hint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can change both later; the uploader can wait until the upload step."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İkisini de sonra değiştirebilirsiniz; yükleyici yükleme adımına kadar bekleyebilir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beides können Sie später ändern; der Uploader kann bis zum Upload-Schritt warten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes cambiar ambos más tarde; quien sube puede esperar al paso de subida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pourrez modifier les deux plus tard ; l’envoi peut attendre l’étape d’envoi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi modificare entrambi più tardi; il caricamento può attendere fino alla fase di upload."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どちらもあとで変更できます。アップロード担当は、アップロードのステップまで決めなくても構いません。"
