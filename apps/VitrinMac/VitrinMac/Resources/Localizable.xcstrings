            "value" : "Starkes Schreiben und Schlussfolgern zu geringeren Kosten. Eine gute Standardwahl für Store-Einträge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buena redacción y razonamiento a menor coste. Una buena opción predeterminada para fichas de la tienda."
