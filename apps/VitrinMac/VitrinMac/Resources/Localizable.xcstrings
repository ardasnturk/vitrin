    "web.key.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in with an Admin or Account Holder Apple Account, and Vitrin creates an Admin team key and adds it for you."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Admin veya Hesap Sahibi olan Apple Hesabınızla giriş yapın; Vitrin bir Admin takım anahtarı oluşturup sizin yerinize ekler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melden Sie sich mit einem Apple-Account an, der Admin oder Account-Inhaber ist. Vitrin erstellt dann einen Admin-Teamschlüssel und fügt ihn für Sie hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión con una cuenta de Apple de administrador o titular de la cuenta, y Vitrin crea una clave de equipo de administrador y la añade por ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous avec un compte Apple administrateur ou titulaire du compte, et Vitrin crée une clé d’équipe administrateur et l’ajoute pour vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi con un account Apple amministratore o titolare dell’account, e Vitrin crea una chiave del team amministratore e la aggiunge per te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理者またはアカウント所有者の Apple アカウントでサインインすると、Vitrinが管理者用のチームキーを作成して追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관리자 또는 계정 소유자의 Apple 계정으로 로그인하면 Vitrin이 관리자 팀 키를 만들어 추가해 줍니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre com uma conta Apple de Administrador ou Titular da Conta, e o Vitrin cria uma chave de equipe de Administrador e a adiciona para você."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用管理员或账户持有人的 Apple 账户登录，Vitrin 会为你创建管理员团队密钥并自动添加。"
          }
        }
      }
    },
    "web.key.manual" : {
      "localizations" : {
        "en" : {
