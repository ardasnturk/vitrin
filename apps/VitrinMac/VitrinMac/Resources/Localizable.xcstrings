    "onb.account.privacy" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The .p8 is copied to ~/Library/Application Support/Vitrin with owner-only permissions. It never leaves this Mac except to sign requests to Apple."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".p8 yalnızca sahibinin okuyabileceği izinlerle ~/Library/Application Support/Vitrin altına kopyalanır. Apple’a giden isteklerin imzası dışında bu Mac’ten çıkmaz."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die .p8 wird nur für den Besitzer lesbar nach ~/Library/Application Support/Vitrin kopiert. Sie verlässt diesen Mac nie, außer zum Signieren von Anfragen an Apple."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El .p8 se copia a ~/Library/Application Support/Vitrin con permisos solo para el propietario. Nunca sale de este Mac, salvo para firmar solicitudes a Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier .p8 est copié dans ~/Library/Application Support/Vitrin, accessible uniquement par son propriétaire. Il ne quitte jamais ce Mac, sauf pour signer les requêtes envoyées à Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il file .p8 viene copiato in ~/Library/Application Support/Vitrin con permessi riservati al proprietario. Non lascia mai questo Mac, se non per firmare le richieste ad Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".p8 は所有者のみの権限で ~/Library/Application Support/Vitrin にコピーされます。Apple へのリクエストへの署名以外で、この Mac の外に出ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".p8 파일은 소유자만 접근할 수 있는 권한으로 ~/Library/Application Support/Vitrin에 복사됩니다. Apple에 보내는 요청에 서명할 때를 제외하고는 이 Mac을 벗어나지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo .p8 é copiado para ~/Library/Application Support/Vitrin com permissões apenas para o proprietário. Ele nunca sai deste Mac, exceto para assinar solicitações à Apple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".p8 文件会拷贝到 ~/Library/Application Support/Vitrin，仅所有者可访问。除了为发给 Apple 的请求签名外，它不会离开这台 Mac。"
          }
        }
      }
    },
