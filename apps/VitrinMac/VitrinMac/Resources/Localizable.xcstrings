        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store yükleyicisi"
          }
        }
      }
    },
    "init.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change both later; the uploader can wait until the upload step."
