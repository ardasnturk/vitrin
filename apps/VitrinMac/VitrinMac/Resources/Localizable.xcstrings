          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für „{stage}“ gibt es ein Briefing für Claude. Lassen Sie Claude es erledigen oder lesen Sie das Briefing und machen Sie es selbst."
          }
        },
        "es" : {
          "stringUnit" : {
