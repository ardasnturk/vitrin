    "info.newapp.bundle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app's unique identifier, the same one your Xcode project uses. Pick one you registered, or type a new one and it's registered when your key allows it."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamanın benzersiz kimliği, Xcode projenizdekiyle aynı olmalı. Kayıtlı bir tanesini seçin ya da yenisini yazın; anahtarınız izin veriyorsa kaydedilir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die eindeutige Kennung der App, dieselbe wie in Ihrem Xcode-Projekt. Wählen Sie eine registrierte aus oder geben Sie eine neue ein; sie wird registriert, sofern Ihr Schlüssel es erlaubt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El identificador único de la app, el mismo que usa tu proyecto de Xcode. Elige uno que hayas registrado o escribe uno nuevo, y se registrará si tu clave lo permite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’identifiant unique de l’app, le même que celui de votre projet Xcode. Choisissez-en un déjà enregistré ou saisissez-en un nouveau : il sera enregistré si votre clé l’autorise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’identificatore univoco dell’app, lo stesso usato dal tuo progetto Xcode. Scegline uno registrato o digitane uno nuovo: verrà registrato se la tua chiave lo consente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ固有の識別子で、Xcodeプロジェクトと同じものです。登録済みのものを選ぶか、新しく入力してください。キーに権限があれば自動で登録されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱의 고유 식별자로, Xcode 프로젝트에서 사용하는 것과 같습니다. 등록된 것을 선택하거나 새로 입력하세요. 키에 권한이 있으면 자동으로 등록됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O identificador exclusivo do app, o mesmo usado no seu projeto do Xcode. Escolha um que você registrou ou digite um novo, e ele será registrado se a sua chave permitir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 的唯一标识符，与你的 Xcode 项目所用的相同。可选择已注册的，或输入新的；如果你的密钥权限允许，它会被自动注册。"
          }
        }
      }
    },
    "info.newapp.name" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The name on the App Store, up to 30 characters. It must be free across the store; you can change it later."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
