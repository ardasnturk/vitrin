          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’hash di approvazione viene ricontrollato prima di inviare qualsiasi cosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信前に、承認時のハッシュがもう一度確認されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전송하기 전에 승인 해시를 다시 확인합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O hash da aprovação é verificado novamente antes de qualquer envio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发送任何内容之前，会再次核对批准哈希。"
          }
        }
      }
    },
    "upload.confirmText" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This sends the approved content to App Store Connect and replaces what is there. Type the app name to confirm."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, onaylı içeriği App Store Connect’e gönderir ve oradakinin yerine koyar. Onaylamak için uygulama adını yazın."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird der freigegebene Inhalt an App Store Connect gesendet und ersetzt das Vorhandene. Geben Sie zur Bestätigung den App-Namen ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto envía el contenido aprobado a App Store Connect y sustituye lo que hay. Escribe el nombre de la app para confirmar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contenu approuvé sera envoyé à App Store Connect et remplacera ce qui s’y trouve. Saisissez le nom de l’app pour confirmer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo invia i contenuti approvati ad App Store Connect e sostituisce quelli presenti. Digita il nome dell’app per confermare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "承認済みの内容を App Store Connect に送信し、現在の内容を置き換えます。確認のため、App名を入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "승인된 콘텐츠를 App Store Connect로 보내 기존 내용을 대체합니다. 확인을 위해 앱 이름을 입력하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto envia o conteúdo aprovado ao App Store Connect e substitui o que estiver lá. Digite o nome do app para confirmar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会把已批准的内容发送到 App Store Connect，并替换原有内容。请输入 App 名称以确认。"
          }
        }
      }
    },
