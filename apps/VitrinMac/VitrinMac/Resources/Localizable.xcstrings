    "flow.intro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your store listing is built step by step. The next step is at the top; what waits for you is on the right."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mağaza listeniz adım adım kurulur. Sıradaki adım üstte, sizi bekleyenler sağda."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Store-Eintrag entsteht Schritt für Schritt. Der nächste Schritt steht oben; was auf Sie wartet, rechts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ficha de la tienda se crea paso a paso. El siguiente paso está arriba; lo que te espera está a la derecha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre fiche se construit étape par étape. La prochaine étape est en haut ; ce qui vous attend est à droite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua scheda dello store si costruisce passo dopo passo. Il prossimo passaggio è in alto; ciò che ti aspetta è a destra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストア掲載は、ステップごとに仕上げていきます。次のステップは上部に、あなたの対応待ちの項目は右側に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스토어 상품 정보는 단계별로 만들어집니다. 다음 단계는 맨 위에, 사용자를 기다리는 항목은 오른쪽에 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A página da sua loja é montada passo a passo. A próxima etapa está no topo; o que aguarda você fica à direita."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "商店商品信息会一步步完成。下一步在顶部；等你处理的事项在右侧。"
          }
        }
      }
    },
