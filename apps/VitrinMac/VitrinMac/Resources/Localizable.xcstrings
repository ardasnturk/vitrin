    "settings.accountIntro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One App Store Connect API key for every project. A project whose own .env names a key keeps using that one."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm projeler için tek bir App Store Connect API anahtarı. Kendi .env dosyasında anahtar olan proje onu kullanmaya devam eder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein App-Store-Connect-API-Schlüssel für alle Projekte. Ein Projekt, dessen eigene .env einen Schlüssel nennt, verwendet weiterhin diesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una clave de la API de App Store Connect para todos los proyectos. Un proyecto cuyo propio .env indique una clave sigue usando esa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une clé d’API App Store Connect pour tous les projets. Un projet dont le .env indique sa propre clé continue d’utiliser celle-ci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una chiave API di App Store Connect per tutti i progetti. Un progetto il cui .env indica una chiave propria continua a usare quella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのプロジェクトで共通の App Store Connect API キーです。独自の .env でキーを指定しているプロジェクトは、そのキーを使い続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 프로젝트에 App Store Connect API 키 하나를 사용합니다. 자체 .env에 키가 지정된 프로젝트는 그 키를 계속 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma chave da API do App Store Connect para todos os projetos. Um projeto cujo próprio .env indica uma chave continua usando essa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有项目共用一个 App Store Connect API 密钥。如果项目自己的 .env 指定了密钥，则继续使用该密钥。"
          }
        }
      }
    },
