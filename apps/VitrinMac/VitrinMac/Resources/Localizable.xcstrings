    "act.phasedCreate.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rolls the update out to automatic updates over seven days."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güncellemeyi otomatik güncellemelere yedi günde yayar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verteilt das Update über sieben Tage an automatische Updates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Despliega la actualización a las actualizaciones automáticas a lo largo de siete días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déploie la mise à jour auprès des mises à jour automatiques sur sept jours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distribuisce l’aggiornamento agli aggiornamenti automatici nell’arco di sette giorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップデートを7日間かけて、自動アップデートの対象に順次配信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7일에 걸쳐 자동 업데이트 사용자에게 업데이트를 순차적으로 배포합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libera a atualização para as atualizações automáticas ao longo de sete dias."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在七天内通过自动更新逐步推送此更新。"
          }
        }
      }
    },
