    "onb.model.opus.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strong writing and reasoning at a lower cost. A good default for store listings."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha düşük maliyetle güçlü yazım ve akıl yürütme. Mağaza listeleri için iyi bir varsayılan."
          }
        },
        "de" : {
          "stringUnit" : {
