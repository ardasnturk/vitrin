    "asc.key.why" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every App Store Connect API key has a role that decides what it can reach. Reading analytics reports takes Admin, Finance or Sales and Reports; only Admin can start them, so choose Admin."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her App Store Connect API anahtarının neye erişebileceğini belirleyen bir rolü vardır. Analitik raporlarını okumak için Admin, Finance veya Sales and Reports gerekir; raporları yalnızca Admin başlatabilir, bu yüzden Admin seçin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder App-Store-Connect-API-Schlüssel hat eine Rolle, die bestimmt, worauf er zugreifen kann. Zum Lesen der Analyseberichte braucht es Admin, Finance oder Sales and Reports; nur Admin kann sie starten, wählen Sie also Admin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada clave de la API de App Store Connect tiene un rol que decide a qué puede acceder. Leer los informes de analíticas requiere Admin, Finance o Sales and Reports; solo Admin puede iniciarlos, así que elige Admin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque clé d’API App Store Connect a un rôle qui détermine ce à quoi elle accède. Lire les rapports d’analyse demande le rôle Admin, Finance ou Sales and Reports ; seul Admin peut les lancer, choisissez donc Admin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni chiave API di App Store Connect ha un ruolo che stabilisce a cosa può accedere. Leggere i report di analisi richiede Admin, Finance o Sales and Reports; solo Admin può avviarli, quindi scegli Admin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect の API キーにはそれぞれロールがあり、アクセスできる範囲が決まります。分析レポートの閲覧には、管理者、財務、または営業とレポートのロールが必要です。レポートの開始は管理者のみ可能なので、管理者を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 App Store Connect API 키에는 접근 범위를 정하는 역할이 있습니다. 분석 리포트를 읽으려면 Admin, Finance 또는 Sales and Reports 역할이 필요하고, 리포트를 시작할 수 있는 것은 Admin뿐이므로 Admin을 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toda chave da API do App Store Connect tem uma função que define o que ela pode acessar. Ler relatórios de análises exige Admin, Finance ou Sales and Reports; só o Admin pode iniciá-los, então escolha Admin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个 App Store Connect API 密钥都有一个角色，决定它能访问的内容。读取分析报告需要 Admin、Finance 或 Sales and Reports 角色；只有 Admin 可以发起报告，因此请选择 Admin。"
          }
        }
      }
    },
