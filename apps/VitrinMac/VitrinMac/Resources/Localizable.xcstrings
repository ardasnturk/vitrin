          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect → Users and Access → Integrations → App Store Connect API. La clé doit avoir le rôle App Manager ; le fichier .p8 ne se télécharge qu’une seule fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
