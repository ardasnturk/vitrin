    "onb.welcome.lead" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin manages your team’s apps in App Store Connect and writes their store listings with Claude: it reads the code, researches keywords, writes the text, renders screenshots and App Previews, and uploads only what you approved."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin, takımınızın App Store Connect’teki uygulamalarını yönetir ve mağaza listelerini Claude ile yazar: kodu okur, anahtar kelimeleri araştırır, metni yazar, ekran görüntülerini ve App Preview’ları üretir, yalnızca onayladığınızı yükler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin verwaltet die Apps Ihres Teams in App Store Connect und schreibt ihre Store-Einträge mit Claude: Es liest den Code, recherchiert Keywords, schreibt die Texte, erstellt Screenshots und App-Vorschauen und lädt nur hoch, was Sie freigegeben haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin gestiona las apps de tu equipo en App Store Connect y redacta sus fichas de la tienda con Claude: lee el código, investiga palabras clave, escribe el texto, genera capturas y App Previews, y sube solo lo que has aprobado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin gère les apps de votre équipe dans App Store Connect et rédige leurs fiches avec Claude : il lit le code, recherche les mots-clés, écrit le texte, génère les captures d’écran et les aperçus d’app, et n’envoie que ce que vous avez approuvé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin gestisce le app del tuo team in App Store Connect e ne scrive le schede dello store con Claude: legge il codice, cerca le parole chiave, scrive i testi, genera screenshot e anteprime app e carica solo ciò che hai approvato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin は、App Store Connect にあるチームのAppを管理し、Claude とストア掲載文を書きます。コードの読み取り、キーワード調査、テキスト作成、スクリーンショットとAppプレビューの生成を行い、承認した内容だけをアップロードします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin은 App Store Connect에서 팀의 앱을 관리하고 Claude와 함께 스토어 상품 정보를 작성합니다. 코드를 읽고, 키워드를 조사하고, 텍스트를 작성하고, 스크린샷과 앱 미리보기를 렌더링하며, 승인한 항목만 업로드합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Vitrin gerencia os apps da sua equipe no App Store Connect e escreve as páginas deles na loja com o Claude: lê o código, pesquisa palavras-chave, escreve o texto, gera capturas de tela e App Previews e envia somente o que você aprovou."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin 管理你团队在 App Store Connect 中的 App，并借助 Claude 撰写商店商品信息：读取代码、调研关键词、撰写文案、渲染截图和 App 预览，并且只上传你批准的内容。"
          }
        }
      }
    },
    "onb.welcome.privacy" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything runs on this Mac. Your key stays in your user folder; Claude runs with your own Claude Code sign-in."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her şey bu Mac’te çalışır. Anahtarınız kullanıcı klasörünüzde kalır; Claude kendi Claude Code oturumunuzla çalışır."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles läuft auf diesem Mac. Ihr Schlüssel bleibt in Ihrem Benutzerordner; Claude läuft mit Ihrer eigenen Claude-Code-Anmeldung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo se ejecuta en este Mac. Tu clave permanece en tu carpeta de usuario; Claude funciona con tu propio inicio de sesión de Claude Code."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout s’exécute sur ce Mac. Votre clé reste dans votre dossier utilisateur ; Claude fonctionne avec votre propre connexion à Claude Code."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto viene eseguito su questo Mac. La tua chiave resta nella cartella utente; Claude funziona con il tuo accesso a Claude Code."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてこの Mac 上で動作します。キーはユーザフォルダ内に保管され、Claude はあなた自身の Claude Code のサインインで動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 작업은 이 Mac에서 실행됩니다. 키는 사용자 폴더에 남아 있으며, Claude는 사용자의 Claude Code 로그인으로 실행됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo roda neste Mac. Sua chave fica na sua pasta de usuário; o Claude roda com o seu próprio login do Claude Code."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一切都在这台 Mac 上运行。你的密钥保存在用户文件夹中；Claude 使用你自己的 Claude Code 登录信息运行。"
          }
        }
      }
    },
    "onb.welcome.tagline" : {
