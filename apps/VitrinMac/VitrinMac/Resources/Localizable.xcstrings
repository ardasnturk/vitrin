    "web.key.confirm" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This creates a new API key with full access to your team and replaces the current key in Vitrin."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem takımınıza tam erişimi olan yeni bir API anahtarı oluşturur ve Vitrin'deki mevcut anahtarın yerine geçer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird ein neuer API-Schlüssel mit vollem Zugriff auf Ihr Team erstellt und der aktuelle Schlüssel in Vitrin ersetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto crea una nueva clave de API con acceso total a tu equipo y sustituye la clave actual en Vitrin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action crée une nouvelle clé d’API avec un accès complet à votre équipe et remplace la clé actuelle dans Vitrin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa azione crea una nuova chiave API con accesso completo al tuo team e sostituisce la chiave attuale in Vitrin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チームへのフルアクセス権を持つ新しいAPIキーを作成し、Vitrinの現在のキーを置き換えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팀에 대한 모든 권한이 있는 새 API 키를 만들고 Vitrin의 현재 키를 교체합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso cria uma nova chave de API com acesso total à sua equipe e substitui a chave atual no Vitrin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将创建一个拥有团队完全访问权限的新 API 密钥，并替换 Vitrin 中的当前密钥。"
          }
        }
      }
    },
