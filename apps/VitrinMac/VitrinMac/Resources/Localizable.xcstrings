    "settings.keySaved" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stored under Application Support/Vitrin with owner-only permissions. Open projects restart their Studio to pick it up."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Application Support/Vitrin altında, yalnızca sahibinin okuyabileceği izinlerle saklanıyor. Açık projelerin Studio’su yeni anahtarla yeniden başlar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesichert unter Application Support/Vitrin, nur für den Besitzer lesbar. Geöffnete Projekte starten ihr Studio neu, um ihn zu übernehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guarda en Application Support/Vitrin con permisos solo para el propietario. Los proyectos abiertos reinician su Studio para usarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stockée dans Application Support/Vitrin, accessible uniquement par son propriétaire. Les projets ouverts redémarrent leur Studio pour la prendre en compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvata in Application Support/Vitrin con permessi riservati al proprietario. I progetti aperti riavviano il proprio Studio per rilevarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Application Support/Vitrin 内に、所有者のみの権限で保存されます。開いているプロジェクトは Studio を再起動して反映します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소유자만 접근할 수 있는 권한으로 Application Support/Vitrin에 저장됩니다. 열려 있는 프로젝트는 Studio를 다시 시작해 반영합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardada em Application Support/Vitrin com permissões apenas para o proprietário. Os projetos abertos reiniciam o Studio para usá-la."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存储在 Application Support/Vitrin 下，仅所有者可访问。已打开的项目会重启其 Studio 以载入。"
          }
        }
      }
    },
