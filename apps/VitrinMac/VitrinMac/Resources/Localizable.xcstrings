    "research.intro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Competitors and keywords from metadata/research/, store by store. Claude scores relevance and picks the terms during “Prepare the store text”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "metadata/research/ içindeki rakipler ve anahtar kelimeler, mağaza mağaza. Claude ilgiyi puanlar ve terimleri “Mağaza metinlerini hazırla” sırasında seçer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitbewerber und Keywords aus metadata/research/, Store für Store. Claude bewertet die Relevanz und wählt die Begriffe bei „Store-Texte vorbereiten“ aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Competidores y palabras clave de metadata/research/, tienda por tienda. Claude puntúa la relevancia y elige los términos durante «Preparar el texto de la tienda»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concurrents et mots-clés de metadata/research/, store par store. Claude évalue la pertinence et choisit les termes pendant « Préparer le texte du store »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concorrenti e parole chiave da metadata/research/, store per store. Claude valuta la pertinenza e sceglie i termini durante “Prepara il testo dello store”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "metadata/research/ にある競合とキーワードを、ストアごとに表示します。Claude が「ストア用テキストを準備」の中で関連度を評価し、語を選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "metadata/research/의 경쟁 앱과 키워드를 스토어별로 보여 줍니다. Claude가 “스토어 텍스트 준비” 단계에서 관련성을 평가하고 용어를 선택합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concorrentes e palavras-chave de metadata/research/, loja por loja. O Claude avalia a relevância e escolhe os termos durante “Preparar o texto da loja”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自 metadata/research/ 的竞争对手和关键词，按商店分别列出。Claude 会在“准备商店文案”步骤中为相关性打分并挑选词语。"
          }
        }
      }
    },
