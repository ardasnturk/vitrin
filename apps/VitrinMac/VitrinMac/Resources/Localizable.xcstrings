    "home.noProjects" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No project folder yet. Add an app’s source folder to let Vitrin and Claude write its store listing."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz proje klasörü yok. Mağaza listesini Vitrin ve Claude’un yazması için bir uygulamanın kaynak klasörünü ekleyin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch kein Projektordner. Fügen Sie den Quellordner einer App hinzu, damit Vitrin und Claude ihren Store-Eintrag schreiben können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay carpeta de proyecto. Añade la carpeta de código de una app para que Vitrin y Claude escriban su ficha de la tienda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun dossier de projet pour l’instant. Ajoutez le dossier source d’une app pour que Vitrin et Claude rédigent sa fiche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora nessuna cartella di progetto. Aggiungi la cartella sorgente di un’app per permettere a Vitrin e Claude di scrivere la sua scheda dello store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトフォルダがまだありません。Appのソースフォルダを追加すると、Vitrin と Claude がストア掲載を書きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로젝트 폴더가 아직 없습니다. 앱의 소스 폴더를 추가하면 Vitrin과 Claude가 스토어 상품 정보를 작성할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não há pasta de projeto. Adicione a pasta de código-fonte de um app para o Vitrin e o Claude escreverem a página dele na loja."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有项目文件夹。添加 App 的源代码文件夹，Vitrin 和 Claude 就能为它撰写商店商品信息。"
          }
        }
      }
