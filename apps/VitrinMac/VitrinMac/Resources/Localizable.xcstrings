    "info.asc.tf.groups" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Internal groups are your team; external groups can be anyone and need Beta App Review. A public link lets people join by themselves."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dahili gruplar ekibinizdir; harici gruplar herkes olabilir ve Beta App Review gerektirir. Herkese açık bağlantıyla kişiler kendileri katılabilir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interne Gruppen sind Ihr Team; externe Gruppen können beliebige Personen sein und benötigen eine Beta-App-Prüfung. Über einen öffentlichen Link können Personen selbst beitreten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los grupos internos son tu equipo; los externos pueden ser cualquiera y requieren Beta App Review. Con un enlace público, la gente puede unirse por su cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les groupes internes sont votre équipe ; les groupes externes peuvent réunir n’importe qui et nécessitent la Beta App Review. Un lien public permet aux gens de rejoindre le groupe eux-mêmes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I gruppi interni sono il tuo team; i gruppi esterni possono includere chiunque e richiedono la revisione Beta App Review. Un link pubblico permette alle persone di unirsi da sole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内部グループはチームのメンバー用です。外部グループは誰でも参加でき、ベータ版App審査が必要です。公開リンクを使うと、参加者が自分で参加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내부 그룹은 팀원으로 구성되고, 외부 그룹은 누구든 참여할 수 있으며 Beta App Review가 필요합니다. 공개 링크를 사용하면 누구나 직접 참여할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupos internos são a sua equipe; grupos externos podem ser qualquer pessoa e precisam da Análise de Apps Beta. Um link público permite que as pessoas entrem por conta própria."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内部群组是你的团队成员；外部群组可以是任何人，需要通过 Beta App 审核。公开链接可让用户自行加入。"
          }
        }
      }
    },
