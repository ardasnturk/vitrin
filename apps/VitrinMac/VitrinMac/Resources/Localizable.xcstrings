    "visuals.samplesIntro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One screenshot in each candidate style. Pick one; Claude writes the art direction and renders the full set."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her aday stilde bir ekran görüntüsü. Birini seçin; Claude sanat yönetimini yazar ve tam seti üretir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Screenshot in jedem Stilvorschlag. Wählen Sie einen aus; Claude schreibt die Art Direction und erstellt das komplette Set."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una captura en cada estilo candidato. Elige uno; Claude redacta la dirección de arte y genera el conjunto completo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une capture d’écran dans chaque style proposé. Choisissez-en un ; Claude rédige la direction artistique et génère le jeu complet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno screenshot per ogni stile candidato. Scegline uno: Claude scrive la direzione artistica e genera il set completo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "候補のスタイルごとにスクリーンショットを1枚ずつ用意しました。1つ選ぶと、Claude がアートディレクションを書き、全体を仕上げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "후보 스타일별로 스크린샷을 한 장씩 만들었습니다. 하나를 고르면 Claude가 아트 디렉션을 작성하고 전체 세트를 렌더링합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma captura de tela em cada estilo candidato. Escolha um; o Claude escreve a direção de arte e gera o conjunto completo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每种候选风格各出一张截图。选一种，Claude 会撰写美术方向并渲染整套截图。"
          }
        }
      }
    },
