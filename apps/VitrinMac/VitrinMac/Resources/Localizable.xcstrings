    "act.phasedUpdate.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pause, resume, or release to everyone now."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duraklatın, sürdürün ya da şimdi herkese yayınlayın."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausieren, fortsetzen oder jetzt für alle freigeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa, reanuda o lanza para todos ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez en pause, reprenez ou publiez pour tout le monde maintenant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti in pausa, riprendi o rilascia a tutti subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時停止、再開、またはすぐに全員へリリースします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일시 중지, 재개하거나 지금 모든 사용자에게 출시합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pause, retome ou libere para todos agora."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
