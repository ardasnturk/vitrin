          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin bulunduğu yerde kendini değiştiremiyor. Uygulamalar klasörüne taşıyın ya da az önce açılan indirme sayfasını kullanın."
