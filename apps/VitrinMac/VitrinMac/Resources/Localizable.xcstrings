    "welcome.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a mobile app’s repository and Vitrin builds its store listing step by step: research, text, screenshots, App Previews, review, upload. Everything lands in the project’s metadata/ folder."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir mobil uygulamanın deposunu ekleyin; Vitrin mağaza listesini adım adım kurar: araştırma, metin, ekran görüntüleri, App Preview, inceleme, yükleme. Her şey projenin metadata/ klasörüne yazılır."
          }
        }
      }
    },
    "projects.title": {
      "localizations": {
