    "onb.done.tip2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Let Claude do it” runs a stage; Claude’s questions appear as cards."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Claude yapsın” bir aşamayı çalıştırır; Claude’un soruları kart olarak görünür."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Claude erledigen lassen“ führt eine Phase aus; Claudes Fragen erscheinen als Karten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Que lo haga Claude» ejecuta una fase; las preguntas de Claude aparecen como tarjetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Laisser Claude s’en charger » lance une étape ; les questions de Claude apparaissent sous forme de cartes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Lascia fare a Claude” esegue una fase; le domande di Claude compaiono come schede."
