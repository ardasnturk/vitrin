    "onb.welcome.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to Vitrin"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitrin’e hoş geldiniz"
          }
        }
      }
    },
    "onb.welcome.tagline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your App Store presence, from one Mac app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store’daki vitrininiz, tek bir Mac uygulamasından."
          }
        }
      }
    },
    "onb.welcome.lead": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitrin manages your team’s apps in App Store Connect and writes their store listings with Claude: it reads the code, researches keywords, writes the text, renders screenshots and App Previews, and uploads only what you approved."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitrin, takımınızın App Store Connect’teki uygulamalarını yönetir ve mağaza listelerini Claude ile yazar: kodu okur, anahtar kelimeleri araştırır, metni yazar, ekran görüntülerini ve App Preview’ları üretir, yalnızca onayladığınızı yükler."
          }
        }
      }
    },
    "onb.welcome.what": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you can do"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neler yapabilirsiniz"
          }
        }
      }
    },
    "onb.welcome.privacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything runs on this Mac. Your key stays in your user folder; Claude runs with your own Claude Code sign-in."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey bu Mac’te çalışır. Anahtarınız kullanıcı klasörünüzde kalır; Claude kendi Claude Code oturumunuzla çalışır."
          }
        }
      }
    },
    "onb.feature.asc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store Connect panel"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store Connect paneli"
          }
        }
      }
    },
    "onb.feature.asc.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every app of your team with its versions and review states, one key for all of them."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takımınızın tüm uygulamaları, sürümleri ve inceleme durumları; hepsi için tek anahtar."
          }
        }
      }
    },
    "onb.feature.claude": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadata with Claude"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
