    "cli.installIntro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app runs the Vitrin command line tool. One click installs it here, along with Node.js if this Mac needs it."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama Vitrin komut satırı aracını çalıştırır. Tek tıkla buradan kurulur; bu Mac'te Node.js yoksa o da kurulur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App nutzt das Vitrin-Befehlszeilentool. Ein Klick installiert es hier, bei Bedarf auch Node.js."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app usa la herramienta de línea de comandos de Vitrin. Con un clic se instala aquí, junto con Node.js si este Mac lo necesita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app utilise l'outil en ligne de commande Vitrin. Un clic l'installe ici, avec Node.js si ce Mac en a besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app usa lo strumento a riga di comando di Vitrin. Con un clic si installa qui, insieme a Node.js se questo Mac ne ha bisogno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリは Vitrin コマンドラインツールを実行します。ここからワンクリックでインストールでき、必要なら Node.js も一緒に入ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱은 Vitrin 명령줄 도구를 실행합니다. 여기서 클릭 한 번으로 설치되며, 필요하면 Node.js도 함께 설치됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app usa a ferramenta de linha de comando do Vitrin. Um clique a instala aqui, junto com o Node.js se este Mac precisar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本应用运行 Vitrin 命令行工具。点按一下即可在此安装,如有需要会同时安装 Node.js。"
          }
        }
      }
    },
    "cli.installPlugin" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Or install the Vitrin plugin in Claude Code and run /vitrin once: the app finds that install too."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya da Claude Code’a Vitrin eklentisini kurup bir kez /vitrin çalıştırın: uygulama o kurulumu da bulur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oder installieren Sie das Vitrin-Plug-in in Claude Code und führen Sie einmal /vitrin aus: Die App findet auch diese Installation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O instala el plugin de Vitrin en Claude Code y ejecuta /vitrin una vez: la app también encuentra esa instalación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou installez le plug-in Vitrin dans Claude Code et lancez /vitrin une fois : l’app détecte aussi cette installation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppure installa il plugin Vitrin in Claude Code ed esegui /vitrin una volta: l’app trova anche quell’installazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "または、Claude Code に Vitrin プラグインをインストールして /vitrin を一度実行してください。そのインストールもアプリが見つけます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "또는 Claude Code에 Vitrin 플러그인을 설치하고 /vitrin을 한 번 실행하세요. 앱이 그 설치도 찾아냅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou instale o plugin do Vitrin no Claude Code e execute /vitrin uma vez: o app também encontra essa instalação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "或者在 Claude Code 中安装 Vitrin 插件并运行一次 /vitrin：App 也能找到该安装。"
          }
        }
      }
    },
