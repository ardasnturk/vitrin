    "asc.analytics.noRequests" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple only prepares analytics reports after you ask once. Ask now, and the first reports arrive in 1–2 days."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple analitik raporlarını siz bir kez isteyince hazırlar. Şimdi isteyin; ilk raporlar 1–2 gün içinde gelir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple erstellt Analyseberichte erst, nachdem Sie sie einmal angefordert haben. Fordern Sie sie jetzt an, die ersten Berichte kommen in 1–2 Tagen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple solo prepara los informes de analíticas después de que los pidas una vez. Pídelos ahora y los primeros llegarán en 1–2 días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ne prépare les rapports d’analyse qu’après une première demande de votre part. Faites-la maintenant : les premiers rapports arrivent sous 1 à 2 jours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple prepara i report di analisi solo dopo una tua richiesta. Chiedili ora e i primi report arrivano in 1–2 giorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple は、一度リクエストしないと分析レポートを用意しません。今すぐリクエストすると、最初のレポートが1～2日で届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple은 한 번 요청해야 분석 리포트를 준비합니다. 지금 요청하면 첫 리포트가 1~2일 안에 도착합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Apple só prepara os relatórios de análises depois que você pede uma vez. Peça agora e os primeiros relatórios chegam em 1 a 2 dias."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 要在你请求一次之后才会生成分析报告。现在请求，首批报告将在 1–2 天内送达。"
          }
        }
      }
    },
