    "listing.asc.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import the live text of {app} (name, subtitle, keywords, description, promotional text, What’s New, URLs) into this project; Claude and you continue from there."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{app} uygulamasının yayındaki metnini (ad, alt başlık, anahtar kelimeler, açıklama, tanıtım metni, yenilikler, URL’ler) bu projeye aktarın; Claude ve siz oradan devam edersiniz."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importieren Sie den Live-Text von {app} (Name, Untertitel, Keywords, Beschreibung, Werbetext, Neuigkeiten, URLs) in dieses Projekt; Claude und Sie machen von dort aus weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa a este proyecto el texto publicado de {app} (nombre, subtítulo, palabras clave, descripción, texto promocional, Novedades, URL); Claude y tú continuáis desde ahí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez dans ce projet le texte en ligne de {app} (nom, sous-titre, mots-clés, description, texte promotionnel, Nouveautés, URL) ; Claude et vous poursuivez à partir de là."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa in questo progetto il testo attualmente online di {app} (nome, sottotitolo, parole chiave, descrizione, testo promozionale, Novità, URL); da lì proseguite tu e Claude."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{app} の公開中のテキスト (名前、サブタイトル、キーワード、説明文、プロモーション用テキスト、新機能、URL) をこのプロジェクトに読み込みます。以降は Claude とあなたで続きを進めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{app}의 게시된 텍스트(이름, 부제, 키워드, 설명, 프로모션 텍스트, 새로운 기능, URL)를 이 프로젝트로 가져옵니다. 이후 작업은 Claude와 함께 이어서 진행합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importe para este projeto o texto atual de {app} (nome, subtítulo, palavras-chave, descrição, texto promocional, Novidades, URLs); a partir daí, você e o Claude continuam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 {app} 的线上文案（名称、副标题、关键词、描述、宣传文本、新功能、URL）导入此项目；之后由你和 Claude 接着完成。"
          }
        }
      }
