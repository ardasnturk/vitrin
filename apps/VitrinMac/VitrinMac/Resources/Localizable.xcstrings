    "init.intro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin writes the config, its own block in .gitignore and the metadata/ folder. Nothing else is touched."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin yapılandırmayı, .gitignore’daki kendi bloğunu ve metadata/ klasörünü yazar. Başka hiçbir şeye dokunulmaz."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin schreibt die Konfiguration, einen eigenen Block in .gitignore und den Ordner metadata/. Sonst wird nichts angefasst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin escribe la configuración, su propio bloque en .gitignore y la carpeta metadata/. No se toca nada más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin écrit la configuration, son propre bloc dans .gitignore et le dossier metadata/. Rien d’autre n’est modifié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin scrive la configurazione, un proprio blocco in .gitignore e la cartella metadata/. Nient’altro viene toccato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin が書き込むのは、設定ファイル、.gitignore 内の専用ブロック、metadata/ フォルダのみです。ほかには触れません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin은 설정 파일, .gitignore의 자체 블록, metadata/ 폴더만 작성합니다. 그 밖의 항목은 건드리지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Vitrin grava a configuração, um bloco próprio no .gitignore e a pasta metadata/. Nada mais é alterado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin 会写入配置文件、.gitignore 中属于它的部分，以及 metadata/ 文件夹。不会改动其他任何内容。"
          }
        }
      }
    },
