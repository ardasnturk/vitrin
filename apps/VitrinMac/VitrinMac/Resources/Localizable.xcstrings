    "review.rejectIntro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select the items to reject and say what should change; Claude reads the comments from metadata/review-feedback.json."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reddedilecek öğeleri seçin ve neyin değişmesi gerektiğini yazın; Claude yorumları metadata/review-feedback.json dosyasından okur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie die abzulehnenden Objekte aus und schreiben Sie, was sich ändern soll; Claude liest die Kommentare aus metadata/review-feedback.json."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona los elementos que rechazar e indica qué debería cambiar; Claude lee los comentarios de metadata/review-feedback.json."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez les éléments à rejeter et indiquez ce qui doit changer ; Claude lit les commentaires dans metadata/review-feedback.json."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
