    "review.approveMessage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exactly this content (by hash) becomes uploadable. Any change afterwards needs a new approval."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam olarak bu içerik (hash ile) yüklenebilir olur. Sonraki her değişiklik yeni onay gerektirir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genau dieser Inhalt (per Hash) wird uploadfähig. Jede spätere Änderung erfordert eine neue Freigabe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exactamente este contenido (por hash) pasa a poder subirse. Cualquier cambio posterior requiere una nueva aprobación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exactement ce contenu (identifié par son hash) pourra être envoyé. Toute modification ultérieure nécessite une nouvelle approbation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esattamente questo contenuto (in base all’hash) diventa caricabile. Qualsiasi modifica successiva richiede una nuova approvazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップロードできるのは、この内容 (ハッシュで特定) だけです。以降に変更があった場合は、あらためて承認が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정확히 이 콘텐츠(해시 기준)만 업로드할 수 있게 됩니다. 이후에 바뀌면 다시 승인해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exatamente este conteúdo (pelo hash) passa a poder ser enviado. Qualquer alteração depois exige uma nova aprovação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有与此完全一致（按哈希核对）的内容才能上传。之后的任何更改都需要重新批准。"
          }
        }
      }
    },
