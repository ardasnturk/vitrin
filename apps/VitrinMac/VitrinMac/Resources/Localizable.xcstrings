    "updates.cliHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each app version installs its own Vitrin CLI after it updates. Releases on GitHub (ardasnturk/vitrin) carry the CLI tarball and SHA256SUMS."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her uygulama sürümü, güncellendikten sonra kendi Vitrin CLI'ını kurar. GitHub sürümleri (ardasnturk/vitrin) CLI tarball'ını ve SHA256SUMS'u taşır."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede App-Version installiert nach dem Update ihre eigene Vitrin CLI. GitHub-Releases (ardasnturk/vitrin) enthalten das CLI-Tarball und SHA256SUMS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada versión de la app instala su propia Vitrin CLI tras actualizarse. Las versiones de GitHub (ardasnturk/vitrin) incluyen el tarball de la CLI y SHA256SUMS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque version de l'app installe sa propre Vitrin CLI après sa mise à jour. Les versions GitHub (ardasnturk/vitrin) contiennent le tarball de la CLI et SHA256SUMS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
