    "init.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder has no vitrin.config.yaml yet"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu klasörde henüz vitrin.config.yaml yok"
          }
        }
      }
    },
    "init.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitrin writes the config, its own block in .gitignore and the metadata/ folder. Nothing else is touched."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitrin yapılandırmayı, .gitignore’daki kendi bloğunu ve metadata/ klasörünü yazar. Başka hiçbir şeye dokunulmaz."
          }
        }
      }
    },
    "init.language": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language Vitrin talks to you in"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitrin’in sizinle konuştuğu dil"
          }
        }
