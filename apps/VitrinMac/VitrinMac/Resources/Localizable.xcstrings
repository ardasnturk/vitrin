    "upload.confirmHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The approval hash is checked again before anything is sent."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herhangi bir şey gönderilmeden önce onay hash’i yeniden denetlenir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Freigabe-Hash wird erneut geprüft, bevor etwas gesendet wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El hash de la aprobación se vuelve a comprobar antes de enviar nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
