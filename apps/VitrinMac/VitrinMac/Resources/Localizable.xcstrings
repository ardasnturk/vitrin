    "onb.tools.subtitle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin runs a few command-line tools. The required ones must be here; the others unlock more stages."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin birkaç komut satırı aracı çalıştırır. Zorunlu olanlar şart; diğerleri ek aşamaları açar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin führt einige Befehlszeilentools aus. Die erforderlichen müssen vorhanden sein; die übrigen schalten weitere Phasen frei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin ejecuta algunas herramientas de línea de comandos. Las obligatorias deben estar presentes; las demás desbloquean más fases."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin utilise quelques outils en ligne de commande. Les outils requis doivent être présents ; les autres débloquent davantage d’étapes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin usa alcuni strumenti a riga di comando. Quelli richiesti devono essere presenti; gli altri sbloccano più fasi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin はいくつかのコマンドラインツールを使います。必須のツールは必ず必要で、ほかのツールがあると利用できるステージが増えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin은 몇 가지 명령줄 도구를 실행합니다. 필수 도구는 반드시 있어야 하고, 나머지는 더 많은 단계를 사용할 수 있게 해 줍니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Vitrin executa algumas ferramentas de linha de comando. As obrigatórias precisam estar presentes; as outras liberam mais etapas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrin 会运行一些命令行工具。必需的工具必须存在；其他工具可解锁更多阶段。"
          }
        }
      }
    },
