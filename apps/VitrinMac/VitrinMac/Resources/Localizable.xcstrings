    "flow.nextClaude" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“{stage}” has a brief for Claude. Let Claude do it, or read the brief and do it yourself."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
