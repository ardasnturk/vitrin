    "onb.model.fable.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The most capable model: the best writing and analysis, the slowest and most expensive."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En yetenekli model: en iyi yazım ve analiz, en yavaş ve en pahalı."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das leistungsfähigste Modell: das beste Schreiben und die beste Analyse, aber das langsamste und teuerste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo más capaz: la mejor redacción y análisis, el más lento y el más caro."
