    "onb.account.step3.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple lets you download it only once. Choose it below; Vitrin keeps its own copy."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple yalnızca bir kez indirmenize izin verir. Aşağıda seçin; Vitrin kendi kopyasını saklar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple erlaubt das Laden nur einmal. Wählen Sie die Datei unten aus; Vitrin behält eine eigene Kopie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple solo permite descargarla una vez. Elígela abajo; Vitrin guarda su propia copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ne permet de la télécharger qu’une seule fois. Choisissez-la ci-dessous ; Vitrin en garde sa propre copie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple permette di scaricarlo una sola volta. Sceglilo qui sotto; Vitrin ne conserva una copia propria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple がダウンロードを許可するのは一度だけです。下で選択してください。Vitrin が独自にコピーを保管します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple은 한 번만 다운로드할 수 있게 합니다. 아래에서 파일을 선택하면 Vitrin이 자체 사본을 보관합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Apple só permite baixá-lo uma vez. Escolha-o abaixo; o Vitrin guarda uma cópia própria."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 只允许下载一次。请在下方选择该文件；Vitrin 会保留自己的副本。"
          }
        }
      }
    },
    "onb.account.subtitle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One API key for every app and project. Vitrin checks it by listing your team’s apps."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm uygulamalar ve projeler için tek API anahtarı. Vitrin anahtarı takımınızın uygulamalarını listeleyerek doğrular."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein API-Schlüssel für alle Apps und Projekte. Vitrin prüft ihn, indem es die Apps Ihres Teams auflistet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una clave de API para todas las apps y proyectos. Vitrin la comprueba listando las apps de tu equipo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une clé d’API pour toutes les apps et tous les projets. Vitrin la vérifie en listant les apps de votre équipe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una chiave API per tutte le app e i progetti. Vitrin la verifica elencando le app del tuo team."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのAppとプロジェクトで共通の API キーです。Vitrin はチームのAppを一覧表示して、キーを確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 앱과 프로젝트에 API 키 하나를 사용합니다. Vitrin은 팀의 앱 목록을 불러와 키를 확인합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma chave de API para todos os apps e projetos. O Vitrin a verifica listando os apps da sua equipe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有 App 和项目共用一个 API 密钥。Vitrin 会通过列出团队的 App 来验证它。"
          }
        }
      }
    },
