    "act.requestAnalytics.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asks Apple to prepare this app's reports daily, weekly and monthly. Needs an Admin key."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple'dan bu uygulamanın raporlarını günlük, haftalık ve aylık hazırlamasını ister. Admin anahtarı gerekir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bittet Apple, die Berichte dieser App täglich, wöchentlich und monatlich zu erstellen. Erfordert einen Admin-Schlüssel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide a Apple que prepare los informes de esta app a diario, cada semana y cada mes. Requiere una clave de Admin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande à Apple de préparer les rapports de cette app chaque jour, semaine et mois. Nécessite une clé Admin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiede ad Apple di preparare i report di questa app ogni giorno, settimana e mese. Richiede una chiave Admin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このAppのレポートを日次・週次・月次で用意するよう Apple にリクエストします。管理者のキーが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple에 이 앱의 리포트를 일간, 주간, 월간으로 준비하도록 요청합니다. Admin 키가 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pede à Apple que prepare os relatórios deste app diária, semanal e mensalmente. Exige uma chave de Admin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请 Apple 按日、周、月为此 App 生成报告。需要管理员权限的密钥。"
          }
        }
      }
    },
