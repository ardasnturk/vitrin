    "onb.claude.note" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude runs with your own Claude Code sign-in; Vitrin needs no API key for it. Each run shows the model it used."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude kendi Claude Code oturumunuzla çalışır; Vitrin bunun için API anahtarı istemez. Her çalıştırma kullandığı modeli gösterir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude läuft mit Ihrer eigenen Claude-Code-Anmeldung; Vitrin braucht dafür keinen API-Schlüssel. Jeder Lauf zeigt das verwendete Modell."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude funciona con tu propio inicio de sesión de Claude Code; Vitrin no necesita ninguna clave de API para ello. Cada ejecución muestra el modelo que usó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude fonctionne avec votre propre connexion à Claude Code ; Vitrin n’a besoin d’aucune clé d’API pour cela. Chaque exécution indique le modèle utilisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude funziona con il tuo accesso a Claude Code; Vitrin non richiede alcuna chiave API. Ogni esecuzione mostra il modello usato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude はあなた自身の Claude Code のサインインで動作するため、Vitrin に API キーは不要です。実行のたびに、使用したモデルが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude는 사용자의 Claude Code 로그인으로 실행되며, Vitrin에는 별도의 API 키가 필요하지 않습니다. 실행할 때마다 사용된 모델이 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Claude roda com o seu próprio login do Claude Code; o Vitrin não precisa de chave de API para isso. Cada execução mostra o modelo usado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude 使用你自己的 Claude Code 登录信息运行；Vitrin 无需为此提供 API 密钥。每次运行都会显示所用的模型。"
          }
        }
      }
    },
    "onb.claude.subtitle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code writes the creative stages in your project. Choose the model it uses; you can change it any time."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code projenizde yaratıcı aşamaları yazar. Kullanacağı modeli seçin; istediğiniz zaman değiştirebilirsiniz."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code schreibt die kreativen Phasen in Ihrem Projekt. Wählen Sie das Modell, das es nutzt; Sie können es jederzeit ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code escribe las fases creativas en tu proyecto. Elige el modelo que usa; puedes cambiarlo en cualquier momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code rédige les étapes créatives dans votre projet. Choisissez le modèle qu’il utilise ; vous pouvez le changer à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code scrive le fasi creative nel tuo progetto. Scegli il modello da usare; puoi cambiarlo in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code が、プロジェクト内でクリエイティブの各ステージを作成します。使用するモデルを選んでください。いつでも変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code가 프로젝트에서 크리에이티브 단계를 작성합니다. 사용할 모델을 선택하세요. 언제든지 바꿀 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Claude Code escreve as etapas criativas no seu projeto. Escolha o modelo que ele usa; você pode mudar a qualquer momento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code 会在你的项目中完成各创意阶段。请选择它使用的模型；之后可随时更改。"
          }
        }
      }
    },
