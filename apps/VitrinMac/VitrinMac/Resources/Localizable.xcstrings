    "act.validate.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything App Review needs, checked before you submit: text, screenshots, build, age rating, privacy."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Göndermeden önce App İnceleme’nin istediği her şey denetlenir: metin, ekran görüntüleri, derleme, yaş sınırı, gizlilik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was die App-Prüfung braucht, wird vor dem Einreichen geprüft: Text, Screenshots, Build, Altersfreigabe, Datenschutz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que necesita App Review, comprobado antes de enviar: texto, capturas, compilación, clasificación por edad, privacidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce dont l’App Review a besoin, vérifié avant la soumission : texte, captures d’écran, build, classification par âge, confidentialité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto ciò che serve ad App Review, controllato prima dell’invio: testi, screenshot, build, classificazione per età, privacy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App審査に必要なものを、提出前にまとめて確認します。テキスト、スクリーンショット、ビルド、年齢制限、プライバシーが対象です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제출하기 전에 App Review에 필요한 모든 항목을 점검합니다: 텍스트, 스크린샷, 빌드, 연령 등급, 개인정보 보호."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo o que a Análise do App precisa, conferido antes do envio: texto, capturas de tela, build, classificação etária, privacidade."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提交前检查 App 审核所需的一切：文案、截图、构建版本、年龄分级、隐私。"
          }
        }
      }
    },
