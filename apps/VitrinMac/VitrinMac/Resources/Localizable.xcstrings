    "ads.why" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Ads is separate from App Store Connect, with its own API user and key. Vitrin makes the key and signs in; Apple needs three steps from you once."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Ads, App Store Connect'ten ayrıdır; kendi API kullanıcısı ve anahtarı vardır. Anahtarı Vitrin oluşturur ve giriş yapar; Apple sizden bir kereliğine üç adım ister."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Ads ist von App Store Connect getrennt und hat einen eigenen API-Benutzer und Schlüssel. Vitrin erstellt den Schlüssel und meldet sich an; Apple verlangt einmalig drei Schritte von Ihnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Ads es independiente de App Store Connect, con su propio usuario y clave de API. Vitrin crea la clave e inicia sesión; Apple necesita que hagas tres pasos una sola vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Ads est distinct d’App Store Connect, avec son propre utilisateur d’API et sa propre clé. Vitrin crée la clé et se connecte ; Apple demande trois étapes de votre part, une seule fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Ads è separato da App Store Connect, con un proprio utente API e una propria chiave. Vitrin crea la chiave e accede; Apple richiede da te tre passaggi, una sola volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Ads は App Store Connect とは別で、専用の API ユーザとキーがあります。キーの作成とサインインは Vitrin が行います。あなたには、Apple 側で一度だけ3つの手順をお願いします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Ads는 App Store Connect와 별개이며 자체 API 사용자와 키를 사용합니다. Vitrin이 키를 만들고 로그인하며, Apple 쪽에서는 사용자가 한 번 세 단계를 진행해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Apple Ads é separado do App Store Connect, com usuário e chave de API próprios. O Vitrin cria a chave e faz o login; a Apple exige três etapas suas, uma única vez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Ads 独立于 App Store Connect，拥有自己的 API 用户和密钥。Vitrin 会生成密钥并登录；Apple 需要你一次性完成三个步骤。"
          }
        }
      }
    },
