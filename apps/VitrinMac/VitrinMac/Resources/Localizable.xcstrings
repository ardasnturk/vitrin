    "act.addGroups.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds a build to a TestFlight group; external groups can go to beta review."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir derlemeyi TestFlight grubuna ekler; harici gruplar beta incelemesine gidebilir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt einen Build zu einer TestFlight-Gruppe hinzu; externe Gruppen können zur Beta-Prüfung gehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una compilación a un grupo de TestFlight; los grupos externos pueden pasar a revisión beta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute un build à un groupe TestFlight ; les groupes externes peuvent passer à la revue bêta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge una build a un gruppo TestFlight; i gruppi esterni possono andare in revisione beta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビルドを TestFlight グループに追加します。外部グループはベータ版審査に提出できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빌드를 TestFlight 그룹에 추가합니다. 외부 그룹은 베타 심사로 보낼 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona um build a um grupo do TestFlight; grupos externos podem ir para a análise beta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将构建版本添加到 TestFlight 群组；外部群组可提交 Beta 审核。"
          }
        }
      }
    },
