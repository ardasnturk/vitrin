      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your store listing is built step by step. The next step is at the top; what waits for you is on the right."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mağaza listeniz adım adım kurulur. Sıradaki adım üstte, sizi bekleyenler sağda."
