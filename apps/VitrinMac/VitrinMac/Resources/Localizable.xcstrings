        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "둘 다 나중에 변경할 수 있으며, 업로더는 업로드 단계까지 기다려도 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode mudar os dois depois; o envio pode esperar até a etapa de envio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两项都可以稍后更改；上传者可以等到上传步骤再设置。"
          }
        }
      }
