    "settings.claudeModelHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passed to Claude Code as --model for every run: an alias (fable, opus, sonnet, haiku) or a full name. The Claude column shows the model each run used."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her çalıştırmada Claude Code’a --model olarak verilir: bir takma ad (fable, opus, sonnet, haiku) ya da tam ad. Claude sütunu her çalıştırmanın kullandığı modeli gösterir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird bei jedem Lauf als --model an Claude Code übergeben: ein Alias (fable, opus, sonnet, haiku) oder ein vollständiger Name. Die Spalte „Claude“ zeigt das Modell, das jeder Lauf verwendet hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se pasa a Claude Code como --model en cada ejecución: un alias (fable, opus, sonnet, haiku) o un nombre completo. La columna Claude muestra el modelo que usó cada ejecución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transmis à Claude Code avec --model à chaque exécution : un alias (fable, opus, sonnet, haiku) ou un nom complet. La colonne Claude indique le modèle utilisé à chaque exécution."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passato a Claude Code come --model a ogni esecuzione: un alias (fable, opus, sonnet, haiku) o un nome completo. La colonna Claude mostra il modello usato da ogni esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行のたびに Claude Code へ --model として渡されます。エイリアス (fable、opus、sonnet、haiku) か正式名称を指定します。Claude 列には、各実行で使われたモデルが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실행할 때마다 Claude Code에 --model로 전달됩니다. 별칭(fable, opus, sonnet, haiku) 또는 전체 이름을 입력하세요. Claude 열에는 각 실행에 사용된 모델이 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviado ao Claude Code como --model em cada execução: um alias (fable, opus, sonnet, haiku) ou um nome completo. A coluna Claude mostra o modelo usado em cada execução."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次运行都会以 --model 传给 Claude Code：可以是别名（fable、opus、sonnet、haiku）或完整名称。Claude 列显示每次运行所用的模型。"
