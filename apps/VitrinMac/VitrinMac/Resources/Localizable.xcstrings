    "visuals.intro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything the design, capture and video stages rendered, as it would appear on the store."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasarım, yakalama ve video aşamalarının ürettiği her şey, mağazada görüneceği gibi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was die Phasen Gestaltung, Aufnahme und Video erzeugt haben, so wie es im Store erscheint."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que generaron las fases de diseño, captura y vídeo, tal como aparecería en la tienda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce que les étapes de design, de capture et de vidéo ont généré, tel que cela apparaîtrait sur le store."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto ciò che le fasi di design, acquisizione e video hanno generato, come apparirebbe sullo store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デザイン、キャプチャ、ビデオの各ステージで生成したものを、ストアでの見え方のまま表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디자인, 캡처, 비디오 단계에서 렌더링한 모든 결과를 스토어에 표시될 모습 그대로 보여 줍니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo o que as etapas de design, captura e vídeo geraram, como aparecerá na loja."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设计、截屏和视频阶段渲染出的所有内容，与其在商店中的显示效果一致。"
          }
        }
      }
    },
