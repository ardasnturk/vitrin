    "flow.briefIntro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What Claude is asked to do for this stage. Doing it yourself? Follow these steps, then run the stage again."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu aşama için Claude’a verilen görev. Kendiniz yapacaksanız bu adımları izleyin, sonra aşamayı yeniden çalıştırın."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was Claude in dieser Phase tun soll. Möchten Sie es selbst erledigen? Folgen Sie diesen Schritten und führen Sie die Phase dann erneut aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que se le pide a Claude en esta fase. ¿Prefieres hacerlo tú? Sigue estos pasos y vuelve a ejecutar la fase."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que l’on demande à Claude pour cette étape. Vous préférez le faire vous-même ? Suivez ces étapes, puis relancez l’étape."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa viene chiesto a Claude per questa fase. Preferisci farlo tu? Segui questi passaggi, poi esegui di nuovo la fase."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このステージで Claude に依頼する内容です。自分で行う場合は、この手順に従ってから、ステージをもう一度実行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 단계에서 Claude에게 요청하는 작업입니다. 직접 하시나요? 이 단계를 따라 한 다음 단계를 다시 실행하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que se pede ao Claude nesta etapa. Vai fazer você mesmo? Siga estes passos e execute a etapa novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此阶段要求 Claude 完成的工作。想自己动手？请按这些步骤操作，然后重新运行该阶段。"
          }
        }
      }
    },
