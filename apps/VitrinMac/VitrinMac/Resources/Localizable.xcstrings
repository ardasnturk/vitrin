    "web.analytics.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See the last 30 days as in App Store Connect: downloads, sales, retention. This uses your Apple Account, so it works even if your API key can't read analytics."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son 30 günü App Store Connect'teki gibi görün: indirmeler, satışlar, elde tutma. Apple Hesabınızı kullandığı için API anahtarınız analitiği okuyamasa da çalışır."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehen Sie die letzten 30 Tage wie in App Store Connect: Downloads, Verkäufe, Kundenbindung. Dies nutzt Ihren Apple-Account und funktioniert daher auch, wenn Ihr API-Schlüssel keine Analysedaten lesen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta los últimos 30 días como en App Store Connect: descargas, ventas, retención. Usa tu cuenta de Apple, así que funciona aunque tu clave de API no pueda leer las analíticas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultez les 30 derniers jours comme dans App Store Connect : téléchargements, ventes, rétention. Cela utilise votre compte Apple, donc cela fonctionne même si votre clé d’API ne peut pas lire les analyses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta gli ultimi 30 giorni come in App Store Connect: download, vendite, fidelizzazione. Usa il tuo account Apple, quindi funziona anche se la tua chiave API non può leggere le analisi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connectと同じように、過去30日間のダウンロード数、売上、継続率を確認できます。Apple アカウントを使用するため、APIキーでアナリティクスを読み取れない場合でも利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect와 같이 지난 30일간의 다운로드, 판매, 유지율을 확인합니다. Apple 계정을 사용하므로 API 키로 분석 데이터를 읽을 수 없어도 작동합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja os últimos 30 dias como no App Store Connect: downloads, vendas, retenção. Isso usa sua conta Apple, então funciona mesmo que sua chave de API não consiga ler as análises."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像在 App Store Connect 中一样查看最近 30 天的下载量、销售额和留存率。此功能使用你的 Apple 账户，因此即使你的 API 密钥无法读取分析数据也能使用。"
          }
        }
      }
    },
