        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle le plus performant : la meilleure rédaction et la meilleure analyse, mais aussi le plus lent et le plus cher."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il modello più potente: la migliore scrittura e analisi, ma il più lento e costoso."
