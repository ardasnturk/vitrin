    "asc.key.agreements" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple blocks this until the Account Holder signs the pending agreements in App Store Connect."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesap sahibi App Store Connect'te bekleyen sözleşmeleri imzalayana kadar Apple buna izin vermiyor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple blockiert dies, bis der Account Holder die ausstehenden Vereinbarungen in App Store Connect unterzeichnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple lo bloquea hasta que el titular de la cuenta firme los acuerdos pendientes en App Store Connect."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple bloque cette action tant que le titulaire du compte n’a pas signé les accords en attente dans App Store Connect."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple blocca questa operazione finché il titolare dell’account non firma i contratti in sospeso in App Store Connect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect で、アカウントホルダーが未承諾の契約に同意するまで、Apple によりこの操作はブロックされています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정 소유자가 App Store Connect에서 대기 중인 계약에 서명할 때까지 Apple이 이 작업을 막습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Apple bloqueia isso até que o Titular da Conta assine os contratos pendentes no App Store Connect."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在账户持有人于 App Store Connect 中签署待处理的协议之前，Apple 会阻止此操作。"
          }
        }
      }
    },
    "asc.key.denied" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This API key's role doesn't allow this."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu API anahtarının rolü buna izin vermiyor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Rolle dieses API-Schlüssels erlaubt das nicht."
          }
        },
        "es" : {
          "stringUnit" : {
