    "ads.step1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As an account administrator, sign in to Apple Ads with Sign In > Advanced. Go to Account Settings > User Management, click Invite Users, enter the name and Apple Account, choose an API user role under User Access and Role, and send the invite. That person accepts it from the email."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesap yöneticisi olarak Apple Ads'e Sign In > Advanced ile girin. Account Settings > User Management'ta Invite Users'a tıklayın, adı ve Apple Hesabı'nı yazın, User Access and Role altında bir API kullanıcı rolü seçip daveti gönderin. Davetli kişi e-postadaki bağlantıdan kabul eder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melden Sie sich als Kontoadministrator mit Sign In > Advanced bei Apple Ads an. Öffnen Sie Account Settings > User Management, klicken Sie auf Invite Users, geben Sie Name und Apple-Account ein, wählen Sie unter User Access and Role eine API-Benutzerrolle und senden Sie die Einladung. Die Person nimmt sie über die E-Mail an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como administrador de la cuenta, inicia sesión en Apple Ads con Sign In > Advanced. Ve a Account Settings > User Management, haz clic en Invite Users, introduce el nombre y la cuenta de Apple, elige un rol de usuario de API en User Access and Role y envía la invitación. Esa persona la acepta desde el correo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tant qu’administrateur du compte, connectez-vous à Apple Ads avec Sign In > Advanced. Allez dans Account Settings > User Management, cliquez sur Invite Users, saisissez le nom et le compte Apple, choisissez un rôle d’utilisateur d’API sous User Access and Role, puis envoyez l’invitation. La personne l’accepte depuis l’e-mail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come amministratore dell’account, accedi ad Apple Ads con Sign In > Advanced. Vai a Account Settings > User Management, fai clic su Invite Users, inserisci il nome e l’account Apple, scegli un ruolo utente API in User Access and Role e invia l’invito. La persona lo accetta dall’email."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントの管理者として、Apple Ads に Sign In > Advanced からサインインします。Account Settings > User Management を開き、Invite Users をクリックして、名前と Apple アカウントを入力し、User Access and Role で API ユーザのロールを選んで招待を送信します。招待された人は、届いたメールから承諾します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정 관리자로 Apple Ads에 Sign In > Advanced로 로그인하세요. Account Settings > User Management로 이동해 Invite Users를 클릭하고, 이름과 Apple 계정을 입력한 다음 User Access and Role에서 API 사용자 역할을 선택하여 초대를 보내세요. 초대받은 사람은 이메일에서 수락하면 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como administrador da conta, entre no Apple Ads com Sign In > Advanced. Vá em Account Settings > User Management, clique em Invite Users, informe o nome e a Conta Apple, escolha uma função de usuário de API em User Access and Role e envie o convite. A pessoa aceita o convite pelo e-mail."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以账户管理员身份通过 Sign In > Advanced 登录 Apple Ads。前往 Account Settings > User Management，点按 Invite Users，输入姓名和 Apple 账户，在 User Access and Role 下选择 API 用户角色，然后发送邀请。对方通过邮件接受邀请即可。"
          }
        }
      }
    },
    "ads.step1.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invite an API user"
          }
        },
        "tr" : {
