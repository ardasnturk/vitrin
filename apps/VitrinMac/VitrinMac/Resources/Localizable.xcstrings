        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最も高性能なモデルです。文章も分析も最高ですが、最も遅く、コストも最も高くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
