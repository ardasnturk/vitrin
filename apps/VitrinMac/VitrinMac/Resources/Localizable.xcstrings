    "asc.key.note" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a Team key: individual keys can't reach sales and finance. The new key replaces the current one in Vitrin."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Team anahtarı kullanın: bireysel anahtarlar satış ve finans verilerine erişemez. Yeni anahtar Vitrin'de mevcut anahtarın yerine geçer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie einen Team-Schlüssel: Einzelschlüssel haben keinen Zugriff auf Verkäufe und Finanzen. Der neue Schlüssel ersetzt in Vitrin den aktuellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa una clave de equipo: las claves individuales no acceden a ventas ni finanzas. La nueva clave sustituye a la actual en Vitrin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez une clé d’équipe : les clés individuelles n’ont pas accès aux ventes ni aux finances. La nouvelle clé remplace l’actuelle dans Vitrin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa una chiave del team: le chiavi individuali non accedono a vendite e finanza. La nuova chiave sostituisce quella attuale in Vitrin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チームキーを使ってください。個人キーでは売上と財務にアクセスできません。新しいキーは、Vitrin 内の現在のキーを置き換えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Team 키를 사용하세요. 개인 키로는 판매 및 재무 데이터에 접근할 수 없습니다. 새 키가 Vitrin의 현재 키를 대체합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use uma chave de equipe: chaves individuais não acessam vendas e finanças. A nova chave substitui a atual no Vitrin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请使用 Team 密钥：个人密钥无法访问销售和财务数据。新密钥会替换 Vitrin 中的当前密钥。"
          }
        }
      }
    },
