    "blocker.design-choice" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The design samples are ready ({n} styles). Pick the one the screenshots should use; Claude continues with your choice."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasarım örnekleri hazır ({n} stil). Ekran görüntülerinde hangisinin kullanılacağını seçin; Claude seçiminizle devam eder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Designmuster sind fertig ({n} Stile). Wählen Sie den Stil für die Screenshots aus; Claude macht mit Ihrer Wahl weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las muestras de diseño están listas ({n} estilos). Elige el que deben usar las capturas; Claude continúa con tu elección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les exemples de design sont prêts ({n} styles). Choisissez celui que les captures d’écran doivent utiliser ; Claude continue avec votre choix."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I campioni di design sono pronti ({n} stili). Scegli quello da usare per gli screenshot; Claude prosegue con la tua scelta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デザインサンプルができました ({n} スタイル)。スクリーンショットに使うものを選んでください。Claude は選んだものを使って続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디자인 샘플이 준비되었습니다(스타일 {n}개). 스크린샷에 사용할 스타일을 고르면 Claude가 그 선택으로 이어서 진행합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As amostras de design estão prontas ({n} estilos). Escolha o que as capturas de tela devem usar; o Claude continua com a sua escolha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设计样张已就绪（共 {n} 种风格）。请选择截图要采用的风格；Claude 会按你的选择继续。"
          }
        }
      }
    },
