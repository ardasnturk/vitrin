    "asc.cmd.pickDetail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every asc command is here, with its help and its flags as a form. Commands run read-only unless you allow changes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm asc komutları burada; yardımı ve bayrakları bir form olarak. Değişikliklere izin vermedikçe komutlar salt okunur çalışır."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier finden Sie jeden asc-Befehl mit Hilfe und Optionen als Formular. Befehle laufen nur lesend, solange Sie keine Änderungen erlauben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí están todos los comandos de asc, con su ayuda y sus opciones en forma de formulario. Los comandos son de solo lectura a menos que permitas cambios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les commandes asc sont ici, avec leur aide et leurs options sous forme de formulaire. Les commandes s’exécutent en lecture seule, sauf si vous autorisez les modifications."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui trovi tutti i comandi asc, con la loro guida e le opzioni sotto forma di modulo. I comandi sono in sola lettura, a meno che tu non consenta le modifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "asc のコマンドをすべてここに掲載しています。ヘルプとオプションはフォームで入力できます。変更を許可しない限り、コマンドは読み取り専用で実行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 asc 명령이 도움말 및 플래그와 함께 양식 형태로 모여 있습니다. 변경을 허용하지 않으면 명령은 읽기 전용으로 실행됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os comandos do asc estão aqui, com a ajuda e as opções em forma de formulário. Os comandos rodam somente para leitura, a menos que você permita alterações."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这里列出了所有 asc 命令，其说明和参数以表单形式呈现。除非你允许更改，否则命令都以只读方式运行。"
          }
        }
      }
    },
