    "home.key.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With one API key Vitrin lists every app of your team, its versions and review states, and uploads what you approve."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek bir API anahtarıyla Vitrin takımınızın tüm uygulamalarını, sürümlerini ve inceleme durumlarını listeler, onayladıklarınızı yükler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit einem API-Schlüssel listet Vitrin jede App Ihres Teams mit Versionen und Prüfstatus auf und lädt hoch, was Sie freigeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con una clave de API, Vitrin muestra todas las apps de tu equipo, sus versiones y estados de revisión, y sube lo que apruebes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec une seule clé d’API, Vitrin liste toutes les apps de votre équipe, leurs versions et leurs états de revue, et envoie ce que vous approuvez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con una sola chiave API Vitrin elenca tutte le app del tuo team, con versioni e stati di revisione, e carica ciò che approvi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API キーが1つあれば、Vitrin はチームのすべてのApp、バージョン、審査状況を一覧表示し、承認した内容をアップロードします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API 키 하나로 Vitrin이 팀의 모든 앱과 버전, 심사 상태를 보여 주고 승인한 내용을 업로드합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com uma chave de API, o Vitrin lista todos os apps da sua equipe, suas versões e estados de análise, e envia o que você aprova."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只需一个 API 密钥，Vitrin 就能列出团队的所有 App、版本和审核状态，并上传你批准的内容。"
          }
        }
      }
    },
