    "review.intro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything that would be uploaded, as the gallery shows it. Approve all of it, or reject items with a comment for Claude."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüklenecek her şey, galeride gösterildiği gibi. Tümünü onaylayın ya da Claude için yorumla öğeleri reddedin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was hochgeladen würde, so wie die Galerie es zeigt. Geben Sie alles frei oder lehnen Sie Objekte mit einem Kommentar für Claude ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que se subiría, tal como lo muestra la galería. Apruébalo todo o rechaza elementos con un comentario para Claude."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce qui serait envoyé, tel que la galerie l’affiche. Approuvez le tout, ou rejetez des éléments avec un commentaire pour Claude."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto ciò che verrebbe caricato, come mostra la galleria. Approvalo tutto oppure rifiuta degli elementi con un commento per Claude."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップロードされる内容すべてを、ギャラリーの表示のまま確認できます。すべて承認するか、Claude へのコメントを付けて項目を却下してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업로드될 모든 항목을 갤러리에 표시된 모습 그대로 보여 줍니다. 전부 승인하거나, Claude에게 전달할 의견과 함께 항목을 거부하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo o que seria enviado, como a galeria mostra. Aprove tudo ou rejeite itens com um comentário para o Claude."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将上传的所有内容，与总览中显示的一致。可全部批准，也可拒绝个别项目并给 Claude 留言。"
          }
        }
      }
    },
