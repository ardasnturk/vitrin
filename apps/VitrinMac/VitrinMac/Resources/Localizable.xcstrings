    "asc.key.step4" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click Download API Key to get the .p8 file. Apple lets you download it only once, so keep it safe."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download API Key ile .p8 dosyasını indirin. Apple bu dosyayı yalnızca bir kez indirtir, güvenli bir yerde saklayın."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken Sie auf Download API Key, um die .p8-Datei zu laden. Apple erlaubt das nur einmal, bewahren Sie sie daher sicher auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en Download API Key para obtener el archivo .p8. Apple solo permite descargarlo una vez, así que guárdalo bien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur Download API Key pour obtenir le fichier .p8. Apple ne permet de le télécharger qu’une seule fois : conservez-le en lieu sûr."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su Download API Key per ottenere il file .p8. Apple permette di scaricarlo una sola volta, quindi conservalo al sicuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download API Key をクリックして .p8 ファイルを入手します。ダウンロードできるのは一度だけなので、大切に保管してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download API Key를 클릭해 .p8 파일을 받으세요. Apple은 한 번만 다운로드할 수 있게 하므로 안전하게 보관하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em Download API Key para obter o arquivo .p8. A Apple só permite baixá-lo uma vez, então guarde-o em local seguro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按 Download API Key 获取 .p8 文件。Apple 只允许下载一次，请妥善保管。"
          }
        }
      }
    },
